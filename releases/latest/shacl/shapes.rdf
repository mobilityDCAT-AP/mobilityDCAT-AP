  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Dataset_Shape">
    <sh:description xml:lang="en">Extends DCAT-AP 3.0.1 Dataset. Raises distribution, frequency, spatial, publisher to mandatory. Adds mobilityTheme.</sh:description>
    <sh:name xml:lang="en">Dataset (mobilityDCAT-AP)</sh:name>
