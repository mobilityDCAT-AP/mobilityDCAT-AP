  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#RightsStatement_Shape">
    <sh:description xml:lang="en">A statement about intellectual property rights. Adds mandatory conditions for access and usage.</sh:description>
    <sh:name xml:lang="en">Rights Statement (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#RightsStatement_Shape_description">
        <sh:description xml:lang="en">Free-text rights statement (path changed from rdfs:label to dct:description). Repeated for parallel language versions (§12) (0..n).</sh:description>
        <sh:message xml:lang="en">Rights statement text must be a literal</sh:message>
        <sh:name xml:lang="en">rights statement text</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/description"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#RightsStatement_Shape_type">
        <sh:description xml:lang="en">Conditions for access and usage from the mobilityDCAT-AP controlled vocabulary (1..n).</sh:description>
        <sh:message xml:lang="en">Conditions for access and usage is mandatory. At least one value must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">conditions for access and usage</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/type"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape">
    <sh:description xml:lang="en">Extends DCAT-AP 3.0.1 Distribution. Raises format, rights to mandatory. Adds mobilityDataStandard.</sh:description>
    <sh:name xml:lang="en">Distribution (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_accessURL">
        <sh:description xml:lang="en">URL giving access to the Distribution. mobilityDCAT-AP adds maxCount 1 (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Access URL is mandatory. Exactly one must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">access URL</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#accessURL"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_applicationLayerProtocol">
        <sh:description xml:lang="en">Transmitting channel of the distribution (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Application layer protocol can appear at most once</sh:message>
        <sh:name xml:lang="en">application layer protocol</sh:name>
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#applicationLayerProtocol"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_characterEncoding">
        <sh:description xml:lang="en">Technical encoding format of the delivered content. geoDCAT-AP addition (not in DCAT-AP Distribution) (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Character encoding must be a literal and can appear at most once</sh:message>
        <sh:name xml:lang="en">character encoding</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://www.w3.org/2011/content#characterEncoding"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_communicationMethod">
        <sh:description xml:lang="en">Push or pull mode of the data interface (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Communication method can appear at most once</sh:message>
        <sh:name xml:lang="en">communication method</sh:name>
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#communicationMethod"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_dataFormatNotes">
        <sh:description xml:lang="en">Additional textual information about the format. Repeated for parallel language versions (§12) (0..*).</sh:description>
        <sh:message xml:lang="en">Data format notes must be a literal</sh:message>
        <sh:name xml:lang="en">data format notes</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#dataFormatNotes"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_description">
        <sh:description xml:lang="en">Free-text account of the Distribution (§12) (0..n). Adds EU-language-tag check over the inherited DCAT-AP constraint.</sh:description>
        <sh:languageIn rdf:parseType="Resource">
          <rdf:first>bg</rdf:first>
          <rdf:rest rdf:parseType="Resource">
            <rdf:first>cs</rdf:first>
            <rdf:rest rdf:parseType="Resource">
              <rdf:first>da</rdf:first>
              <rdf:rest rdf:parseType="Resource">
                <rdf:first>de</rdf:first>
                <rdf:rest rdf:parseType="Resource">
                  <rdf:first>el</rdf:first>
                  <rdf:rest rdf:parseType="Resource">
                    <rdf:first>en</rdf:first>
                    <rdf:rest rdf:parseType="Resource">
                      <rdf:first>es</rdf:first>
                      <rdf:rest rdf:parseType="Resource">
                        <rdf:first>et</rdf:first>
                        <rdf:rest rdf:parseType="Resource">
                          <rdf:first>fi</rdf:first>
                          <rdf:rest rdf:parseType="Resource">
                            <rdf:first>fr</rdf:first>
                            <rdf:rest rdf:parseType="Resource">
                              <rdf:first>ga</rdf:first>
                              <rdf:rest rdf:parseType="Resource">
                                <rdf:first>hr</rdf:first>
                                <rdf:rest rdf:parseType="Resource">
                                  <rdf:first>hu</rdf:first>
                                  <rdf:rest rdf:parseType="Resource">
                                    <rdf:first>it</rdf:first>
                                    <rdf:rest rdf:parseType="Resource">
                                      <rdf:first>lt</rdf:first>
                                      <rdf:rest rdf:parseType="Resource">
                                        <rdf:first>lv</rdf:first>
                                        <rdf:rest rdf:parseType="Resource">
                                          <rdf:first>mt</rdf:first>
                                          <rdf:rest rdf:parseType="Resource">
                                            <rdf:first>nl</rdf:first>
                                            <rdf:rest rdf:parseType="Resource">
                                              <rdf:first>pl</rdf:first>
                                              <rdf:rest rdf:parseType="Resource">
                                                <rdf:first>pt</rdf:first>
                                                <rdf:rest rdf:parseType="Resource">
                                                  <rdf:first>ro</rdf:first>
                                                  <rdf:rest rdf:parseType="Resource">
                                                    <rdf:first>sk</rdf:first>
                                                    <rdf:rest rdf:parseType="Resource">
                                                      <rdf:first>sl</rdf:first>
                                                      <rdf:rest rdf:parseType="Resource">
                                                        <rdf:first>sv</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                      </rdf:rest>
                                                    </rdf:rest>
                                                  </rdf:rest>
                                                </rdf:rest>
                                              </rdf:rest>
                                            </rdf:rest>
                                          </rdf:rest>
                                        </rdf:rest>
                                      </rdf:rest>
                                    </rdf:rest>
                                  </rdf:rest>
                                </rdf:rest>
                              </rdf:rest>
                            </rdf:rest>
                          </rdf:rest>
                        </rdf:rest>
                      </rdf:rest>
                    </rdf:rest>
                  </rdf:rest>
                </rdf:rest>
              </rdf:rest>
            </rdf:rest>
          </rdf:rest>
        </sh:languageIn>
        <sh:message xml:lang="en">Description must not be empty, must have a valid EU language tag, and may have only one value per language</sh:message>
        <sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength>
        <sh:name xml:lang="en">description</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/description"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
        <sh:uniqueLang rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sh:uniqueLang>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_downloadURL">
        <sh:description xml:lang="en">Direct link to a downloadable file. mobilityDCAT-AP adds maxCount 1 (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Download URL can appear at most once</sh:message>
        <sh:name xml:lang="en">download URL</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#downloadURL"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_format">
        <sh:description xml:lang="en">Technical syntax of the delivered content. Raised to mandatory (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Format is mandatory. Exactly one must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">format</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/format"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_mobilityDataStandard">
        <sh:description xml:lang="en">Mobility data standard applied for the delivered content. Mandatory, sub-property of dct:conformsTo (1..*).</sh:description>
        <sh:message xml:lang="en">Mobility data standard is mandatory. At least one must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">mobility data standard</sh:name>
        <sh:path rdf:resource="https://w3id.org/mobilitydcat-ap#mobilityDataStandard"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_rights">
        <sh:description xml:lang="en">Rights statement about intellectual property rights. Raised to mandatory (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Rights is mandatory. Exactly one rights statement must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">rights</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/rights"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_sample">
        <sh:description xml:lang="en">Sample of the delivered content. mobilityDCAT-AP places adms:sample on Distribution (0..*).</sh:description>
        <sh:message xml:lang="en">Sample must be a blank node or IRI</sh:message>
        <sh:name xml:lang="en">sample</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:path rdf:resource="http://www.w3.org/ns/adms#sample"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_temporal">
        <sh:description xml:lang="en">Time interval when the distribution is facilitated technically. mobilityDCAT-AP addition on Distribution (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Temporal coverage can appear at most once</sh:message>
        <sh:name xml:lang="en">temporal coverage</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/temporal"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Distribution_Shape_title">
        <sh:description xml:lang="en">Name of the Distribution (§12) (0..n). Adds EU-language-tag check over the inherited DCAT-AP constraint.</sh:description>
        <sh:languageIn rdf:parseType="Resource">
          <rdf:first>bg</rdf:first>
          <rdf:rest rdf:parseType="Resource">
            <rdf:first>cs</rdf:first>
