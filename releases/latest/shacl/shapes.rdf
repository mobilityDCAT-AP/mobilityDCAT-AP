<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:sh="http://www.w3.org/ns/shacl#"
  xmlns:bibo="http://purl.org/ontology/bibo/"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:foaf="http://xmlns.com/foaf/0.1/"
  xmlns:dcat="http://www.w3.org/ns/dcat#"
  xmlns:dcatap="http://data.europa.eu/r5r/"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:adms="http://www.w3.org/ns/adms#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Identifier_Shape">
    <sh:description xml:lang="en">An identifier in a particular context, used as the range of adms:identifier.</sh:description>
    <sh:name xml:lang="en">Identifier (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Identifier_Shape_notation">
        <sh:description xml:lang="en">A string that is an identifier in the context of the identifier scheme referenced by its datatype (1..1).</sh:description>
        <sh:message xml:lang="en">An Identifier must have exactly one skos:notation</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">notation</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#notation"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/adms#Identifier"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape">
    <sh:description xml:lang="en">Extends DCAT-AP 3.0.1 Agent with mobility/geoDCAT contact and organizational properties. Base properties (foaf:name, dct:type) are inherited from DCAT-AP.</sh:description>
    <sh:name xml:lang="en">Agent (mobilityDCAT-AP) - Extensions</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_address">
        <sh:description xml:lang="en">The postal address of the Agent. Analogous to a geoDCAT-AP v3.0.0 addition.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Address must be a blank node or IRI and can appear at most once</sh:message>
        <sh:name xml:lang="en">address</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:path rdf:resource="http://www.w3.org/ns/locn#address"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_affiliation">
        <sh:description xml:lang="en">Organizational affiliation of the Agent. Analogous to a geoDCAT-AP v3.0.0 addition.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Affiliation must be a blank node or IRI and can appear at most once</sh:message>
        <sh:name xml:lang="en">affiliation</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:path rdf:resource="http://www.w3.org/ns/org#memberOf"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_email">
        <sh:description xml:lang="en">The email address of the Agent, specified using fully qualified mailto: URI scheme [RFC6068].</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Email must be an IRI using the mailto: scheme and can appear at most once</sh:message>
        <sh:name xml:lang="en">email</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/mbox"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_firstName">
        <sh:description xml:lang="en">If the agent is a person, this property specifies their first name.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">First name must be a literal and can appear at most once</sh:message>
        <sh:name xml:lang="en">first name</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/firstName"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_phone">
        <sh:description xml:lang="en">The phone number of the Agent, specified using fully qualified tel: URI scheme [RFC3966]. Analogous to a geoDCAT-AP v3.0.0 addition.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Phone must be an IRI using the tel: scheme and can appear at most once</sh:message>
        <sh:name xml:lang="en">phone</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/phone"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_surname">
        <sh:description xml:lang="en">If the agent is a person, this property specifies their surname.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Surname must be a literal and can appear at most once</sh:message>
        <sh:name xml:lang="en">surname</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/surname"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Agent_Shape_workplaceHomepage">
        <sh:description xml:lang="en">The website of the Agent.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Workplace homepage must be an IRI and can appear at most once</sh:message>
        <sh:name xml:lang="en">workplace homepage</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/workplaceHomepage"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape">
    <sh:description xml:lang="en">Extends DCAT-AP 3.0.1 Catalogue. Raises homepage, spatial, record to mandatory.</sh:description>
    <sh:name xml:lang="en">Catalogue (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_description">
        <sh:description xml:lang="en">Free-text description of the mobility data platform. Repeated for parallel language versions (§12).</sh:description>
        <sh:languageIn rdf:parseType="Resource">
          <rdf:first>bg</rdf:first>
          <rdf:rest rdf:parseType="Resource">
            <rdf:first>cs</rdf:first>
            <rdf:rest rdf:parseType="Resource">
              <rdf:first>da</rdf:first>
              <rdf:rest rdf:parseType="Resource">
                <rdf:first>de</rdf:first>
                <rdf:rest rdf:parseType="Resource">
                  <rdf:first>el</rdf:first>
                  <rdf:rest rdf:parseType="Resource">
                    <rdf:first>en</rdf:first>
                    <rdf:rest rdf:parseType="Resource">
                      <rdf:first>es</rdf:first>
                      <rdf:rest rdf:parseType="Resource">
                        <rdf:first>et</rdf:first>
                        <rdf:rest rdf:parseType="Resource">
                          <rdf:first>fi</rdf:first>
                          <rdf:rest rdf:parseType="Resource">
                            <rdf:first>fr</rdf:first>
                            <rdf:rest rdf:parseType="Resource">
                              <rdf:first>ga</rdf:first>
                              <rdf:rest rdf:parseType="Resource">
                                <rdf:first>hr</rdf:first>
                                <rdf:rest rdf:parseType="Resource">
                                  <rdf:first>hu</rdf:first>
                                  <rdf:rest rdf:parseType="Resource">
                                    <rdf:first>it</rdf:first>
                                    <rdf:rest rdf:parseType="Resource">
                                      <rdf:first>lt</rdf:first>
                                      <rdf:rest rdf:parseType="Resource">
                                        <rdf:first>lv</rdf:first>
                                        <rdf:rest rdf:parseType="Resource">
                                          <rdf:first>mt</rdf:first>
                                          <rdf:rest rdf:parseType="Resource">
                                            <rdf:first>nl</rdf:first>
                                            <rdf:rest rdf:parseType="Resource">
                                              <rdf:first>pl</rdf:first>
                                              <rdf:rest rdf:parseType="Resource">
                                                <rdf:first>pt</rdf:first>
                                                <rdf:rest rdf:parseType="Resource">
                                                  <rdf:first>ro</rdf:first>
                                                  <rdf:rest rdf:parseType="Resource">
                                                    <rdf:first>sk</rdf:first>
                                                    <rdf:rest rdf:parseType="Resource">
                                                      <rdf:first>sl</rdf:first>
                                                      <rdf:rest rdf:parseType="Resource">
                                                        <rdf:first>sv</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                      </rdf:rest>
                                                    </rdf:rest>
                                                  </rdf:rest>
                                                </rdf:rest>
                                              </rdf:rest>
                                            </rdf:rest>
                                          </rdf:rest>
                                        </rdf:rest>
                                      </rdf:rest>
                                    </rdf:rest>
                                  </rdf:rest>
                                </rdf:rest>
                              </rdf:rest>
                            </rdf:rest>
                          </rdf:rest>
                        </rdf:rest>
                      </rdf:rest>
                    </rdf:rest>
                  </rdf:rest>
                </rdf:rest>
              </rdf:rest>
            </rdf:rest>
          </rdf:rest>
        </sh:languageIn>
        <sh:message xml:lang="en">Description is mandatory, must not be empty, must have a valid EU language tag, and may have only one value per language</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength>
        <sh:name xml:lang="en">description</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/description"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:uniqueLang rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sh:uniqueLang>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_homepage">
        <sh:description xml:lang="en">Main web page of the mobility data portal. Raised to mandatory (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Homepage is mandatory and must appear exactly once</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">homepage</sh:name>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/homepage"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_identifier">
        <sh:description xml:lang="en">Identifier for the mobility data portal (0..*). SHOULD be the URI from rdf:about. geoDCAT-AP addition (not in DCAT-AP Catalogue).</sh:description>
        <sh:message xml:lang="en">Identifier must be a literal</sh:message>
        <sh:name xml:lang="en">identifier</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/identifier"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_otherIdentifier">
        <sh:description xml:lang="en">Additional identifier besides dct:identifier (mobilityDCAT-AP addition; not in DCAT-AP Catalogue).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Other identifier can appear at most once</sh:message>
        <sh:name xml:lang="en">other identifier</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/adms#identifier"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_record">
        <sh:description xml:lang="en">Metadata record that is part of the Catalogue. Raised to mandatory (1..n).</sh:description>
        <sh:message xml:lang="en">Catalogue must have at least one catalogue record</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">catalogue record</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/dcat#record"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_spatial">
        <sh:description xml:lang="en">Country where the data platform is hosted. Raised to mandatory (1..n).</sh:description>
        <sh:message xml:lang="en">Geographical coverage is mandatory. At least one location must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">geographical coverage</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/spatial"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Catalogue_Shape_title">
        <sh:description xml:lang="en">Name of the mobility data portal. Repeated for parallel language versions (§12).</sh:description>
        <sh:languageIn rdf:parseType="Resource">
          <rdf:first>bg</rdf:first>
          <rdf:rest rdf:parseType="Resource">
            <rdf:first>cs</rdf:first>
            <rdf:rest rdf:parseType="Resource">
              <rdf:first>da</rdf:first>
              <rdf:rest rdf:parseType="Resource">
                <rdf:first>de</rdf:first>
                <rdf:rest rdf:parseType="Resource">
                  <rdf:first>el</rdf:first>
                  <rdf:rest rdf:parseType="Resource">
                    <rdf:first>en</rdf:first>
                    <rdf:rest rdf:parseType="Resource">
                      <rdf:first>es</rdf:first>
                      <rdf:rest rdf:parseType="Resource">
                        <rdf:first>et</rdf:first>
                        <rdf:rest rdf:parseType="Resource">
                          <rdf:first>fi</rdf:first>
                          <rdf:rest rdf:parseType="Resource">
                            <rdf:first>fr</rdf:first>
                            <rdf:rest rdf:parseType="Resource">
                              <rdf:first>ga</rdf:first>
                              <rdf:rest rdf:parseType="Resource">
                                <rdf:first>hr</rdf:first>
                                <rdf:rest rdf:parseType="Resource">
                                  <rdf:first>hu</rdf:first>
                                  <rdf:rest rdf:parseType="Resource">
                                    <rdf:first>it</rdf:first>
                                    <rdf:rest rdf:parseType="Resource">
                                      <rdf:first>lt</rdf:first>
                                      <rdf:rest rdf:parseType="Resource">
                                        <rdf:first>lv</rdf:first>
                                        <rdf:rest rdf:parseType="Resource">
                                          <rdf:first>mt</rdf:first>
                                          <rdf:rest rdf:parseType="Resource">
                                            <rdf:first>nl</rdf:first>
                                            <rdf:rest rdf:parseType="Resource">
                                              <rdf:first>pl</rdf:first>
                                              <rdf:rest rdf:parseType="Resource">
                                                <rdf:first>pt</rdf:first>
                                                <rdf:rest rdf:parseType="Resource">
                                                  <rdf:first>ro</rdf:first>
                                                  <rdf:rest rdf:parseType="Resource">
                                                    <rdf:first>sk</rdf:first>
                                                    <rdf:rest rdf:parseType="Resource">
                                                      <rdf:first>sl</rdf:first>
                                                      <rdf:rest rdf:parseType="Resource">
                                                        <rdf:first>sv</rdf:first>
                                                        <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                                      </rdf:rest>
                                                    </rdf:rest>
                                                  </rdf:rest>
                                                </rdf:rest>
                                              </rdf:rest>
                                            </rdf:rest>
                                          </rdf:rest>
                                        </rdf:rest>
                                      </rdf:rest>
                                    </rdf:rest>
                                  </rdf:rest>
                                </rdf:rest>
                              </rdf:rest>
                            </rdf:rest>
                          </rdf:rest>
                        </rdf:rest>
                      </rdf:rest>
                    </rdf:rest>
                  </rdf:rest>
                </rdf:rest>
              </rdf:rest>
            </rdf:rest>
          </rdf:rest>
        </sh:languageIn>
        <sh:message xml:lang="en">Title is mandatory, must not be empty, must have a valid EU language tag, and may have only one value per language</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:minLength rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minLength>
        <sh:name xml:lang="en">title</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/title"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
        <sh:uniqueLang rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</sh:uniqueLang>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Location_Shape">
    <sh:description xml:lang="en">A spatial region or named place. Adds geoDCAT-AP gazetteer, geographic identifier and geographic name.</sh:description>
    <sh:name xml:lang="en">Location (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Location_Shape_identifier">
        <sh:description xml:lang="en">Geographic identifier for the Location (EU authority tables, NUTS or GeoNames). geoDCAT-AP addition (0..n).</sh:description>
        <sh:message xml:lang="en">Geographic identifier must be a literal or IRI</sh:message>
        <sh:name xml:lang="en">geographic identifier</sh:name>
        <sh:or rdf:parseType="Collection">
          <rdf:Description rdf:nodeID="cb2a50b10e0188b670f09c3a768d636e19e19411b131b4fe687c376363e06a8d7">
            <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
          </rdf:Description>
          <rdf:Description rdf:nodeID="cb13c5c33494cdc68e8288ece8b650325e309616a1a58fa0c8e8fdd1890ad547d52">
            <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
          </rdf:Description>
        </sh:or>
        <sh:path rdf:resource="http://purl.org/dc/terms/identifier"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Location_Shape_inScheme">
        <sh:description xml:lang="en">Gazetteer to which the Location belongs. geoDCAT-AP addition (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Gazetteer can appear at most once</sh:message>
        <sh:name xml:lang="en">gazetteer</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Location_Shape_prefLabel">
        <sh:description xml:lang="en">Preferred label of the Location (§12). geoDCAT-AP addition (0..n).</sh:description>
        <sh:message xml:lang="en">Geographic name must be a literal</sh:message>
