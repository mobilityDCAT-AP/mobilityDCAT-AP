  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Assessment_Shape">
    <sh:description xml:lang="en">An assessment procedure by an external organisation (e.g. a National Body under EU Delegated Regulations).</sh:description>
    <sh:name xml:lang="en">Assessment (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Assessment_Shape_assessmentDate">
        <sh:description xml:lang="en">The date of the latest assessment procedure.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Assessment date must be a temporal literal (xsd:date, xsd:dateTime, xsd:gYear or xsd:gYearMonth) and can appear at most once</sh:message>
        <sh:name xml:lang="en">assessment date</sh:name>
        <sh:or rdf:parseType="Collection">
          <rdf:Description rdf:nodeID="cbd21386f60abdd689527742c7aff4543f4234a720f16b83ce50e5af133f2c4005">
            <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
          </rdf:Description>
          <rdf:Description rdf:nodeID="cb6eb3773ad80e4348baec96cf29f9f092222cc6f446d10e5df5b63db0baa320c2">
            <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
          </rdf:Description>
          <rdf:Description rdf:nodeID="cb79732ee390175663c316de28a940eff32a9a8c88358655936152a7d53bc2f085">
            <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
          </rdf:Description>
          <rdf:Description rdf:nodeID="cbc0188f38d01ef29391da4609bbf2b38b9909a5f09b2d34db85b5c2ca1410bd13">
            <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#gYearMonth"/>
          </rdf:Description>
        </sh:or>
        <sh:path rdf:resource="http://purl.org/dc/terms/issued"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Assessment_Shape_assessmentResult">
        <sh:description xml:lang="en">The result of the latest assessment procedure, as a URL or Embedded Textual Body.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Assessment result can appear at most once</sh:message>
        <sh:name xml:lang="en">assessment result</sh:name>
        <sh:path rdf:resource="http://www.w3.org/ns/oa#hasBody"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="https://w3id.org/mobilitydcat-ap#Assessment"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Concept_Shape">
    <sh:description xml:lang="en">A concept used in context of dcat:theme (renamed from Category).</sh:description>
    <sh:name xml:lang="en">Concept (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Concept_Shape_inScheme">
        <sh:description xml:lang="en">The Concept Scheme to which the Concept belongs.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Concept scheme can appear at most once</sh:message>
        <sh:name xml:lang="en">concept scheme</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetObjectsOf rdf:resource="http://www.w3.org/ns/dcat#theme"/>
  </sh:NodeShape>
  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#CatalogueRecord_Shape">
    <sh:description xml:lang="en">Extends DCAT-AP 3.0.1 Catalogue Record. Raises language and listing date to mandatory.</sh:description>
    <sh:name xml:lang="en">Catalogue Record (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#CatalogueRecord_Shape_language">
        <sh:description xml:lang="en">Language of the textual metadata. Raised to mandatory (1..n).</sh:description>
        <sh:message xml:lang="en">Language is mandatory. At least one language must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">language</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/language"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#CatalogueRecord_Shape_listingDate">
        <sh:description xml:lang="en">Date on which the metadata entry was included in the Catalogue (replaces dct:created). Raised to mandatory (1..1); the Temporal Literal datatype is inherited from DCAT-AP's DateOrDateTimeDataType shape.</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Listing date is mandatory. Exactly one value must be provided</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">listing date</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/issued"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#CatalogueRecord_Shape_publisher">
        <sh:description xml:lang="en">Entity responsible for creation and maintenance of the metadata entry (geoDCAT addition; not in DCAT-AP Catalogue Record).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Publisher can appear at most once</sh:message>
        <sh:name xml:lang="en">publisher</sh:name>
        <sh:path rdf:resource="http://purl.org/dc/terms/publisher"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
  </sh:NodeShape>
</rdf:RDF>
