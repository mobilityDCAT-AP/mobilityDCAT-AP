  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape">
    <sh:description xml:lang="en">Contact information following the vCard specification, used as the range of dcat:contactPoint. Properties analogous to geoDCAT-AP v3.0.0 additions.</sh:description>
    <sh:name xml:lang="en">Kind (mobilityDCAT-AP)</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_email">
        <sh:description xml:lang="en">Email address of the Kind using fully qualified mailto: URI scheme [RFC6068] (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Email is mandatory and must appear exactly once</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">email</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#hasEmail"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_fn">
        <sh:description xml:lang="en">Name of the Kind (1..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Name is mandatory and must appear exactly once</sh:message>
        <sh:minCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:minCount>
        <sh:name xml:lang="en">name</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#fn"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_hasAddress">
        <sh:description xml:lang="en">Postal address of the Kind (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Address can appear at most once</sh:message>
        <sh:name xml:lang="en">address</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#hasAddress"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_hasTelephone">
        <sh:description xml:lang="en">Phone number of the Kind using fully qualified tel: URI scheme [RFC3966] (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Phone can appear at most once</sh:message>
        <sh:name xml:lang="en">phone</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#hasTelephone"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_hasURL">
        <sh:description xml:lang="en">Web site of the Kind (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">URL can appear at most once</sh:message>
        <sh:name xml:lang="en">URL</sh:name>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#hasURL"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes#Kind_Shape_organizationName">
        <sh:description xml:lang="en">Affiliation of the Kind (§12) (0..1).</sh:description>
        <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
        <sh:message xml:lang="en">Affiliation must be a literal and can appear at most once</sh:message>
        <sh:name xml:lang="en">affiliation</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
        <sh:path rdf:resource="http://www.w3.org/2006/vcard/ns#organization-name"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Info"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetObjectsOf rdf:resource="http://www.w3.org/ns/dcat#contactPoint"/>
  </sh:NodeShape>
  <owl:Ontology rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/shapes">
    <dcatap:availability rdf:resource="http://data.europa.eu/r5r/stable"/>
    <dct:conformsTo rdf:resource="https://www.w3.org/TR/shacl"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2023-08-14</dct:created>
    <dct:creator>
      <foaf:Group rdf:nodeID="cb2503e1466647c2e1889d9fbbfab431af4576d6235aa1de8e7e7b67f8a1d20631b">
        <foaf:name>NAPCORE SWG 4.4</foaf:name>
        <foaf:page rdf:resource="https://github.com/mobilityDCAT-AP/mobilityDCAT-AP"/>
