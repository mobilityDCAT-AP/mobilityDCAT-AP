    <dct:rightsHolder rdf:resource="https://napcore.eu/"/>
    <dct:title xml:lang="en">mobilityDCAT-AP 3.0.0 SHACL Constraints - Basic Validation</dct:title>
    <bibo:editor>
      <foaf:Person rdf:nodeID="cb2c9ac7d3ade8c6dded4e58120f93708756f1218ff6eb4777718395c9e81d45cb9">
