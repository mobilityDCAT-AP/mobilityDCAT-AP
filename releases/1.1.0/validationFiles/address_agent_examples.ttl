@prefix : <http://w3id.org/mobilitydcat-ap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#=============================================================
# WHAT IS AN ADDRESS?
#=============================================================
# An Address in mobilityDCAT-AP represents a physical location using the 
# locn:Address class. Addresses are used to provide location information
# for organizations, contact points, and other entities. The Address class
# follows the European INSPIRE standard for addresses.

#=============================================================
# VALID EXAMPLES
#=============================================================

# ✅ EXAMPLE 1: Complete Address Without Data Types
# This example shows a fully specified address with all recommended properties
:CologneHistoricalDistrictAddress a locn:Address ;
    # Country (Level 1 administrative unit)
    locn:adminUnitL1 "Deutschland" ;
    
    # State/Region/Province (Level 2 administrative unit)
    locn:adminUnitL2 "Nordrhein-Westfalen" ;
    
    # City/Town/Village name
    locn:postName "Köln" ;
    
    # Postal/ZIP code
    locn:postCode "50667" ;
    
    # Street address including number
    locn:thoroughfare "Hohe Straße 85" .

# ✅ EXAMPLE 2: Complete Address With Explicit Data Types
# This example shows the same structure but with explicitly typed string literals
:CologneEigelsteinQuarterAddress a locn:Address ;
    locn:adminUnitL1 "Deutschland"^^xsd:string ;
    locn:adminUnitL2 "Nordrhein-Westfalen"^^xsd:string ;
    locn:postName "Köln"^^xsd:string ;
    locn:postCode "50668"^^xsd:string ;
    locn:thoroughfare "Eigelstein 115"^^xsd:string .

# ✅ EXAMPLE 3: Address Used Within an Organization
# This example shows how an address is typically used within an Agent
:organization_123 a foaf:Agent ;
    # Address as a blank node within the Agent
    locn:address [
        a locn:Address ;
        locn:adminUnitL1 "Belgium" ;
        locn:adminUnitL2 "Brussels-Capital Region" ;
        locn:postName "Brussels" ;
        locn:postCode "1000" ;
        locn:thoroughfare "Rue de la Loi 56"
    ] .

#=============================================================
# INVALID EXAMPLES
#=============================================================

# ❌ EXAMPLE 4: Multiple Values for a Property
# This is invalid because each property can have at most one value
:MunichCityHallAddressInvalid1 a locn:Address ;
    # Multiple values violate maxCount 1 constraint
    locn:adminUnitL2 "Bavaria", "Saxony" ;
    locn:postName "Munich" ;
    locn:adminUnitL1 "Germany" ;
    locn:postCode "80331" ;
    locn:thoroughfare "Marienplatz 8" .

# ❌ EXAMPLE 5: Non-Literal Values
# This is invalid because property values must be literals
:MunichCityHallAddressInvalid2 a locn:Address ;
    # URI instead of a literal string
    locn:adminUnitL2 <http://example.org/Bavaria> ;
    locn:postName "Munich" ;
    locn:adminUnitL1 "Germany" ;
    # Number instead of string literal
    locn:postCode 80331 ;
    locn:thoroughfare "Marienplatz 8" .

# ❌ EXAMPLE 6: Blank Node Property Values
# This is invalid because property values must be simple literals
:MunichCityHallAddressInvalid3 a locn:Address
