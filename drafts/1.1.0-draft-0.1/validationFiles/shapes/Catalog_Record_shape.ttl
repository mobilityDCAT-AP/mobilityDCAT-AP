@prefix : <https://w3id.org/mobilitydcat-ap#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Catalog_Record_Shape
  a sh:NodeShape ;
  sh:targetClass dcat:CatalogRecord ;
  sh:name "Catalogue Record"@en ;
  sh:property [
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:path dct:created ;
    sh:or (
      [ sh:datatype xsd:date ; ]
      [ sh:datatype xsd:dateTime ; ]
    );
    sh:name "creation date" ;
    sh:description "This property contains the date stamp (date and time) when the metadata entry was created for the first time. It SHOULD be generated by the system, whenever a platform user enters the metadata entry." ;
    sh:message "Catalogue Record must have exactly one creation date (xsd:date or xsd:dateTime)" ;
    sh:severity sh:Violation
  ],
  [
    sh:minCount 1 ;
    sh:or (
        [ sh:class dct:LinguisticSystem ]
        [ sh:pattern "^http://publications\\.europa\\.eu/resource/authority/language/.+$" ]
    ) ;
    sh:path dct:language ;
    sh:name "language" ;
    sh:description "This property refers to a language used in the textual metadata describing titles, descriptions, etc. of the metadata entry." ;
    sh:message "Catalogue Record must have at least one language (either dct:LinguisticSystem or EU authority URI)" ;
    sh:severity sh:Violation
   ],
  [
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class dcat:Dataset ;
    sh:path foaf:primaryTopic ;
    sh:name "primary topic" ;
    sh:description "This property links the metadata entry to the dataset described in the entry." ;
    sh:message "Catalogue Record must link to exactly one dataset as primary topic" ;
    sh:severity sh:Violation
  ],
  [
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:path dct:modified ;
    sh:or (
      [ sh:datatype xsd:date ; ]
      [ sh:datatype xsd:dateTime ; ]
    );
    sh:name "update / modification date" ;
    sh:description "This property contains the date stamp (date and time) when the metadata entry was last modified." ;
    sh:message "Catalogue Record must have exactly one modification date (xsd:date or xsd:dateTime)" ;
    sh:severity sh:Violation
  ],
  [
    sh:maxCount 1 ;
    sh:class foaf:Agent ;
    sh:path dct:publisher ;
    sh:name "publisher" ;
    sh:description "This property refers to an entity (an organisation or a person), which is responsible for creation and maintenance of the metadata entry on the data platform." ;
    sh:message "Publisher must be a foaf:Agent and can appear at most once" ;
    sh:severity sh:Violation
  ],
  [
    sh:class dcat:CatalogRecord ;
    sh:path dct:source ;
    sh:name "source metadata" ;
    sh:description "This property is used for metadata records that are harvested from other portals." ;
    sh:message "Source must be a dcat:CatalogRecord" ;
    sh:severity sh:Violation
  ] .