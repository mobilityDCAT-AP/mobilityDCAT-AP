@prefix : <https://w3id.org/mobilitydcat-ap#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Checksum_Shape
  a sh:NodeShape ;
  sh:targetClass spdx:Checksum ;
  sh:name "Checksum"@en ;
  sh:description "A value that allows the contents of a file to be authenticated. This class is kept for compatibility with DCAT-AP." ;
  sh:property [
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:path spdx:algorithm ;
    sh:hasValue spdx:checksumAlgorithm_sha1 ;
    sh:name "algorithm" ;
    sh:description "This property identifies the algorithm used to produce the subject Checksum. Currently, SHA-1 is the only supported algorithm." ;
    sh:message "Checksum must specify exactly one algorithm (currently only SHA-1 is supported)" ;
    sh:severity sh:Violation
  ],
  [
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:path spdx:checksumValue ;
    sh:datatype xsd:hexBinary ;
    sh:nodeKind sh:Literal ;
    sh:name "checksum value" ;
    sh:description "This property provides a lower case hexadecimal encoded digest value produced using a specific algorithm." ;
    sh:message "Checksum must specify exactly one checksum value as a hexadecimal string" ;
    sh:severity sh:Violation
  ] .