@prefix : <https://w3id.org/mobilitydcat-ap#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

:Data_Service_Shape
  a sh:NodeShape ;
  sh:targetClass dcat:DataService ;
  sh:name "Data Service"@en ;
  sh:property [
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:path dcat:endpointURL ;
    sh:name "endpoint URL" ;
    sh:description "The root location or primary endpoint of the Service (an IRI)." ;
    sh:message "Data Service must have at least one endpoint URL" ;
    sh:severity sh:Violation
  ],
  [
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path dct:title ;
    sh:name "title" ;
    sh:description "This property contains a name given to the Data Service. This property can be repeated for parallel language versions of the name." ;
    sh:message "Data Service must have at least one title" ;
    sh:severity sh:Violation
  ],
  [
    sh:nodeKind sh:IRI ;
    sh:path dcat:endpointDescription ;
    sh:name "endpoint description" ;
    sh:description "This property contains a description of the Data Services available via the endpoints, including their operations, parameters etc." ;
    sh:message "Endpoint description must be a resource (IRI)" ;
    sh:severity sh:Violation
  ],
  [
    sh:class dcat:Dataset ;
    sh:path dcat:servesDataset ;
    sh:name "serves dataset" ;
    sh:description "This property refers to a Dataset that this Data Service can distribute." ;
    sh:message "Serves dataset must be a dcat:Dataset" ;
    sh:severity sh:Violation
  ],
  [
    sh:maxCount 1 ;
    sh:class dct:RightsStatement ;
    sh:path dct:accessRights ;
    sh:name "access rights" ;
    sh:description "This property MAY include information regarding access or restrictions based on privacy, security, or other policies." ;
    sh:message "Access rights must be a dct:RightsStatement and can appear at most once" ;
    sh:severity sh:Violation
  ],
  [
    sh:nodeKind sh:Literal ;
    sh:path dct:description ;
    sh:name "description" ;
    sh:description "This property contains a free-text account of the Data Service. This property can be repeated for parallel language versions of the description." ;
    sh:message "Description must be a literal" ;
    sh:severity sh:Violation
  ],
  [
    sh:maxCount 1 ;
    sh:class dct:LicenseDocument ;
    sh:path dct:license ;
    sh:name "licence" ;
    sh:description "This property contains the licence under which the Data Service is made available." ;
    sh:message "License must be a dct:LicenseDocument and can appear at most once" ;
    sh:severity sh:Violation
  ] .