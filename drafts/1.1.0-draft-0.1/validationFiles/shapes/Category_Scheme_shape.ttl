@prefix : <https://w3id.org/mobilitydcat-ap#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

:CategoryScheme_Shape
  a sh:NodeShape ;
  sh:targetClass skos:ConceptScheme ;
  sh:name "Category Scheme"@en ;
  sh:property [
    sh:minCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:path dct:title ;
    sh:name "title" ;
    sh:description "This property contains a name of the Category Scheme. May be repeated for different versions of the name." ;
    sh:message "Category Scheme must have at least one title" ;
    sh:severity sh:Violation
  ] .