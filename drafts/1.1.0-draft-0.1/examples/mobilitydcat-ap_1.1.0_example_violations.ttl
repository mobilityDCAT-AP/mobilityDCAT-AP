@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

#=============================================================================
# BROKEN EXAMPLE - mobilityDCAT-AP 1.1.0 Basic Validation Violations
# Each resource deliberately violates one or more shapes.
# Expected violations are commented inline.
#=============================================================================


#-----------------------------------------------------------------------------
# CATALOGUE - triggers Catalogue_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-catalog>
  a dcat:Catalog ;
  # VIOLATION Catalogue_Shape_title: language tag "xx" not in EU language list
  dct:title "Bad Catalog"@xx ;
  # VIOLATION Catalogue_Shape_description: empty literal fails sh:minLength 1
  dct:description ""@en ;
  # VIOLATION Catalogue_Shape_homepage: 2 homepages, maxCount is 1
  foaf:homepage <https://example.org/home1> , <https://example.org/home2> ;
  # VIOLATION Catalogue_Shape_spatial: MISSING (minCount 1) -- no dct:spatial at all
  # VIOLATION Catalogue_Shape_record: MISSING (minCount 1) -- no dcat:record at all
  # VIOLATION Catalogue_Shape_dataset: MISSING (minCount 1) -- no dcat:dataset at all
  dct:publisher <https://example.org/agent/1> .


#-----------------------------------------------------------------------------
# CATALOGUE RECORD - triggers CatalogueRecord_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-record>
  a dcat:CatalogRecord ;
  # VIOLATION CatalogueRecord_Shape_language: MISSING (minCount 1)
  # VIOLATION CatalogueRecord_Shape_creationDate: xsd:gYear not allowed (only date/dateTime)
  dct:created "2023"^^xsd:gYear ;
  foaf:primaryTopic <https://example.org/bad-dataset> .


<https://example.org/bad-record-2>
  a dcat:CatalogRecord ;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
  # VIOLATION CatalogueRecord_Shape_creationDate: 2 values, maxCount 1
  dct:created "2023-01-01"^^xsd:date , "2023-02-01"^^xsd:date ;
  # VIOLATION CatalogueRecord_Shape_publisher: 2 values, maxCount 1
  dct:publisher <https://example.org/agent/1> , <https://example.org/agent/2> .


#-----------------------------------------------------------------------------
# DATASET - triggers Dataset_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-dataset>
  a dcat:Dataset ;
  # VIOLATION Dataset_Shape_title: empty string
  dct:title ""@en ;
  # VIOLATION Dataset_Shape_description: two @en descriptions violates sh:uniqueLang
  dct:description "First description"@en , "Second description"@en ;
  # VIOLATION Dataset_Shape_distribution: MISSING (minCount 1)
  # VIOLATION Dataset_Shape_accrualPeriodicity: MISSING (minCount 1)
  # VIOLATION Dataset_Shape_mobilityTheme: MISSING (minCount 1) -- new mandatory prop
  # VIOLATION Dataset_Shape_spatial: MISSING (minCount 1)
  # VIOLATION Dataset_Shape_publisher: MISSING (minCount 1)
  # VIOLATION Dataset_Shape_issued: xsd:string not allowed (only date/dateTime)
  dct:issued "January 2023" ;
  # VIOLATION Dataset_Shape_identifier: must be literal, but this is an IRI
  dct:identifier <https://example.org/some-id> ;
  # VIOLATION Dataset_Shape_versionInfo: 2 values, maxCount 1
  <http://www.w3.org/2002/07/owl#versionInfo> "1.0" , "1.1" .


<https://example.org/bad-dataset-2>
  a dcat:Dataset ;
  dct:title "OK title"@en ;
  dct:description "OK description"@en ;
  # VIOLATION Dataset_Shape_accrualPeriodicity: 2 values, maxCount 1
  dct:accrualPeriodicity
    <http://publications.europa.eu/resource/authority/frequency/DAILY> ,
    <http://publications.europa.eu/resource/authority/frequency/WEEKLY> ;
  # VIOLATION Dataset_Shape_publisher: 2 values, maxCount 1
  dct:publisher <https://example.org/agent/1> , <https://example.org/agent/2> ;
  mobilitydcatap:mobilityTheme <https://example.org/theme/speed-limits> ;
  dct:spatial <https://example.org/location/sweden> ;
  dcat:distribution <https://example.org/bad-distribution> .


#-----------------------------------------------------------------------------
# DISTRIBUTION - triggers Distribution_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-distribution>
  a dcat:Distribution ;
  # VIOLATION Distribution_Shape_accessURL: 2 values, mobilityDCAT enforces maxCount 1
  dcat:accessURL <https://example.org/access/1> , <https://example.org/access/2> ;
  # VIOLATION Distribution_Shape_format: MISSING (minCount 1)
  # VIOLATION Distribution_Shape_rights: MISSING (minCount 1)
  # VIOLATION Distribution_Shape_mobilityDataStandard: MISSING (minCount 1) -- new mandatory prop
  dct:title "Bad Distribution"@en .


<https://example.org/bad-distribution-2>
  a dcat:Distribution ;
  # VIOLATION Distribution_Shape_accessURL: MISSING (minCount 1)
  # VIOLATION Distribution_Shape_format: 2 values, maxCount 1
  dct:format
    <http://publications.europa.eu/resource/authority/file-type/XML> ,
    <http://publications.europa.eu/resource/authority/file-type/JSON> ;
  # VIOLATION Distribution_Shape_rights: 2 values, maxCount 1
  dct:rights <https://example.org/rights/1> , <https://example.org/rights/2> ;
  # VIOLATION Distribution_Shape_mobilityDataStandard: 2 values, maxCount 1
  mobilitydcatap:mobilityDataStandard
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/datex-II> ,
    <https://w3id.org/mobilitydcat-ap/mobility-data-standard/gtfs> ;
  # VIOLATION Distribution_Shape_description: 2 @en, uniqueLang fails
  dct:description "Desc one"@en , "Desc two"@en ;
  # VIOLATION Distribution_Shape_downloadURL: 2 values, maxCount 1
  dcat:downloadURL <https://example.org/dl/1> , <https://example.org/dl/2> .


#-----------------------------------------------------------------------------
# AGENT - triggers Agent_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/agent/1>
  a foaf:Agent ;
  foaf:name "Bad Agent" ;
  # VIOLATION Agent_Shape_email: not IRI (literal), nodeKind sh:IRI required
  foaf:mbox "not-an-iri@example.com" ;
  # VIOLATION Agent_Shape_phone: not IRI (literal), nodeKind sh:IRI required
  foaf:phone "+46-123-456789" ;
  # VIOLATION Agent_Shape_firstName: 2 values, maxCount 1
  foaf:firstName "John" , "Johnny" ;
  # VIOLATION Agent_Shape_surname: not literal, nodeKind sh:Literal required
  foaf:surname <https://example.org/surname/doe> ;
  # VIOLATION Agent_Shape_workplaceHomepage: 2 values, maxCount 1
  foaf:workplaceHomepage <https://example.org/work/1> , <https://example.org/work/2> .


#-----------------------------------------------------------------------------
# ADDRESS - triggers Address_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-address>
  a locn:Address ;
  # VIOLATION Address_Shape_adminUnitL1: 2 values, maxCount 1
  locn:adminUnitL1 "Sweden" , "SE" ;
  # VIOLATION Address_Shape_postCode: must be literal, this is IRI
  locn:postCode <https://example.org/postcode/12345> ;
  # VIOLATION Address_Shape_postName: 2 values, maxCount 1
  locn:postName "Stockholm" , "Stockholm City" ;
  # VIOLATION Address_Shape_thoroughfare: must be literal, this is IRI
  locn:thoroughfare <https://example.org/street/main> .


#-----------------------------------------------------------------------------
# LOCATION - triggers Location_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/location/sweden>
  a dct:Location ;
  # VIOLATION Location_Shape_bbox: must be literal, this is IRI
  dcat:bbox <https://example.org/bbox/1> ;
  # VIOLATION Location_Shape_centroid: 2 values, maxCount 1
  dcat:centroid "POINT(15 62)" , "POINT(14 60)" ;
  # VIOLATION Location_Shape_inScheme: 2 values, maxCount 1
  skos:inScheme <https://example.org/scheme/1> , <https://example.org/scheme/2> ;
  # VIOLATION Location_Shape_geometry: 2 values, maxCount 1
  locn:geometry "POLYGON(...)" , "POLYGON(...)" .


#-----------------------------------------------------------------------------
# RIGHTS STATEMENT - triggers RightsStatement_Shape violation
#-----------------------------------------------------------------------------
<https://example.org/bad-rights>
  a dct:RightsStatement .
  # VIOLATION RightsStatement_Shape_type: MISSING (minCount 1) -- mandatory


#-----------------------------------------------------------------------------
# VCARD KIND - triggers Kind_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-kind>
  a vcard:Kind ;
  # VIOLATION Kind_Shape_email: MISSING (minCount 1) -- mandatory
  # VIOLATION Kind_Shape_fn: MISSING (minCount 1) -- mandatory
  # VIOLATION Kind_Shape_hasURL: 2 values, maxCount 1
  vcard:hasURL <https://example.org/url/1> , <https://example.org/url/2> ;
  # VIOLATION Kind_Shape_hasAddress: 2 values, maxCount 1
  vcard:hasAddress <https://example.org/addr/1> , <https://example.org/addr/2> ;
  # VIOLATION Kind_Shape_hasTelephone: 2 values, maxCount 1
  vcard:hasTelephone <tel:+46123> , <tel:+46456> .


#-----------------------------------------------------------------------------
# CHECKSUM - triggers Checksum_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-checksum>
  a spdx:Checksum ;
  # VIOLATION Checksum_Shape_algorithm: must be spdx:checksumAlgorithm_sha1 (sh:hasValue)
  spdx:algorithm spdx:checksumAlgorithm_md5 ;
  # VIOLATION Checksum_Shape_checksumValue: must be xsd:hexBinary, this is plain string
  spdx:checksumValue "not-a-hex-value" .


#-----------------------------------------------------------------------------
# PERIOD OF TIME - triggers PeriodOfTime_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-period>
  a dct:PeriodOfTime ;
  # VIOLATION PeriodOfTime_Shape_startDate: xsd:string not allowed (only date/dateTime)
  dcat:startDate "January" ;
  # VIOLATION PeriodOfTime_Shape_endDate: 2 values, maxCount 1
  dcat:endDate "2023-12-31"^^xsd:date , "2024-01-01"^^xsd:date .


#-----------------------------------------------------------------------------
# ASSESSMENT - triggers Assessment_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-assessment>
  a mobilitydcatap:Assessment ;
  # VIOLATION Assessment_Shape_assessmentDate: 2 values, maxCount 1
  dct:issued "2023-01-01"^^xsd:date , "2023-06-01"^^xsd:date ;
  # VIOLATION Assessment_Shape_assessmentResult: 2 values, maxCount 1
  <http://www.w3.org/ns/oa#hasBody>
    <https://example.org/result/1> , <https://example.org/result/2> .


#-----------------------------------------------------------------------------
# QUALITY ANNOTATION - triggers QualityAnnotation_Shape violations
#-----------------------------------------------------------------------------
<https://example.org/bad-quality>
  a dqv:QualityAnnotation ;
  # VIOLATION QualityAnnotation_Shape_hasBody: 2 values, maxCount 1
  <http://www.w3.org/ns/oa#hasBody>
    <https://example.org/body/1> , <https://example.org/body/2> ;
  # VIOLATION QualityAnnotation_Shape_hasTarget: 2 values, maxCount 1
  <http://www.w3.org/ns/oa#hasTarget>
    <https://example.org/bad-dataset> , <https://example.org/bad-dataset-2> .
