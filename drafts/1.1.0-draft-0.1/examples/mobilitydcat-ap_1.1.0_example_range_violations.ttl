@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mobilitydcatap: <https://w3id.org/mobilitydcat-ap#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dcatap: <http://data.europa.eu/r5r/> .

#=============================================================================
# BROKEN EXAMPLE - mobilityDCAT-AP 1.1.0 RANGE CONSTRAINT Violations
#
# This file targets the RANGE shapes file only.
# All resources below are structurally OK (basic layer passes) but have
# wrong VALUE TYPES to trigger the range (sh:class / pattern / nodeKind)
# constraints.
#=============================================================================


#-----------------------------------------------------------------------------
# AGENT - triggers Agent_Shape_*_range
#-----------------------------------------------------------------------------
<https://example.org/agent/bad>
  a foaf:Agent ;
  foaf:name "Bad Agent" ;
  # VIOLATION Agent_Shape_address_range: must be locn:Address, this is dcat:Dataset
  locn:address <https://example.org/wrong-address-type> ;
  # VIOLATION Agent_Shape_affiliation_range: must be org:Organization, this is foaf:Agent
  org:memberOf <https://example.org/wrong-org-type> .


<https://example.org/wrong-address-type>
  a dcat:Dataset ;
  dct:title "Not an Address"@en .


<https://example.org/wrong-org-type>
  a foaf:Agent ;
  foaf:name "Not an Organization" .


#-----------------------------------------------------------------------------
# CATALOGUE RECORD - triggers CatalogueRecord_Shape_publisher_range
#-----------------------------------------------------------------------------
<https://example.org/record/bad>
  a dcat:CatalogRecord ;
  dct:language <http://publications.europa.eu/resource/authority/language/ENG> ;
  dct:created "2023-01-01"^^xsd:date ;
  foaf:primaryTopic <https://example.org/dataset/ok> ;
  # VIOLATION CatalogueRecord_Shape_publisher_range: must be foaf:Agent, this is dcat:Dataset
  dct:publisher <https://example.org/wrong-publisher-type> .


<https://example.org/wrong-publisher-type>
  a dcat:Dataset ;
  dct:title "Not an Agent"@en .


#-----------------------------------------------------------------------------
# DATA SERVICE - triggers DataService_Shape_*_range
#-----------------------------------------------------------------------------
<https://example.org/dataservice/bad>
  a dcat:DataService ;
  dct:title "Bad Data Service"@en ;
  # VIOLATION DataService_Shape_endpointURL_range: must be IRI/blank node, this is literal
  dcat:endpointURL "https://example.org/endpoint-as-string" ;
  # VIOLATION DataService_Shape_servesDataset_range: must be dcat:Dataset, this is foaf:Agent
  dcat:servesDataset <https://example.org/agent/bad> ;
  # VIOLATION DataService_Shape_accessRights_range: must be dct:RightsStatement, this is dcat:Dataset
  dct:accessRights <https://example.org/dataset/ok> ;
  # VIOLATION DataService_Shape_licence_range: must be dct:LicenseDocument, this is foaf:Agent
  dct:license <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# DATASET - triggers Dataset_Shape_*_range (mandatory range violations)
#-----------------------------------------------------------------------------
<https://example.org/dataset/bad-ranges>
  a dcat:Dataset ;
  dct:title "Dataset with bad value types"@en ;
  dct:description "All mandatory fields present, but values have wrong types"@en ;

  # VIOLATION Dataset_Shape_distribution_range: must be dcat:Distribution, this is foaf:Agent
  dcat:distribution <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_accrualPeriodicity_range: URI doesn't match authority/frequency or mobility update-frequency pattern
  dct:accrualPeriodicity <https://example.org/made-up-frequency/never> ;

  # VIOLATION Dataset_Shape_mobilityTheme_range: URI doesn't match the mobilitydcat-ap/mobility-theme/ pattern
  mobilitydcatap:mobilityTheme <https://example.org/not-an-official-theme> ;

  # VIOLATION Dataset_Shape_spatial_range: must be IRI/blank node, this is a literal
  dct:spatial "Sweden" ;

  # VIOLATION Dataset_Shape_publisher_range: must be foaf:Agent, this is dcat:Dataset
  dct:publisher <https://example.org/wrong-publisher-type> ;

  # ===== RECOMMENDED =====
  # VIOLATION Dataset_Shape_contactPoint_range: must be vcard:Kind, this is foaf:Agent
  dcat:contactPoint <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_rightsHolder_range: must be foaf:Agent, this is dcat:Dataset
  dct:rightsHolder <https://example.org/dataset/ok> ;

  # VIOLATION Dataset_Shape_theme_range: URI doesn't match authority/data-theme pattern
  dcat:theme <https://example.org/not-an-eu-theme> ;

  # VIOLATION Dataset_Shape_temporal_range: must be dct:PeriodOfTime, this is foaf:Agent
  dct:temporal <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_transportMode_range: URI doesn't match mobilitydcat-ap/transport-mode/ pattern
  mobilitydcatap:transportMode <https://example.org/made-up/road> ;

  # VIOLATION Dataset_Shape_georeferencingMethod_range: URI doesn't match pattern
  mobilitydcatap:georeferencingMethod <https://example.org/fake-georef/gps> ;

  # VIOLATION Dataset_Shape_networkCoverage_range: URI doesn't match pattern
  mobilitydcatap:networkCoverage <https://example.org/fake-network/tern> ;

  # VIOLATION Dataset_Shape_conformsTo_range: URI doesn't match OGC EPSG pattern
  dct:conformsTo <https://example.org/not-an-epsg/4326> ;

  # ===== OPTIONAL =====
  # VIOLATION Dataset_Shape_assessmentResult_range: must be mobilitydcatap:Assessment, this is foaf:Agent
  mobilitydcatap:assessmentResult <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_hasVersion_range: must be dcat:Dataset, this is foaf:Agent
  dct:hasVersion <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_isVersionOf_range: must be dcat:Dataset, this is foaf:Agent
  dct:isVersionOf <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_intendedInformationService_range: URI doesn't match pattern
  mobilitydcatap:intendedInformationService <https://example.org/fake/traffic> ;

  # VIOLATION Dataset_Shape_language_range: must be dct:LinguisticSystem, this is foaf:Agent
  dct:language <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_otherIdentifier_range: must be adms:Identifier, this is foaf:Agent
  adms:identifier <https://example.org/agent/bad> ;

  # VIOLATION Dataset_Shape_hasQualityAnnotation_range: must be dqv:QualityAnnotation, this is foaf:Agent
  dqv:hasQualityAnnotation <https://example.org/agent/bad> .


<https://example.org/dataset/ok>
  a dcat:Dataset ;
  dct:title "Harmless dataset used as wrong-type target"@en .


#-----------------------------------------------------------------------------
# DISTRIBUTION - triggers Distribution_Shape_*_range
#-----------------------------------------------------------------------------
<https://example.org/distribution/bad-ranges>
  a dcat:Distribution ;

  # VIOLATION Distribution_Shape_accessURL_range: must be IRI/blank node, this is literal
  dcat:accessURL "not-an-iri-string" ;

  # VIOLATION Distribution_Shape_mobilityDataStandard_range:
  # URI doesn't match mobilitydcat-ap/mobility-data-standard/ pattern AND not a MobilityDataStandard class instance
  mobilitydcatap:mobilityDataStandard <https://example.org/some-other-standard/xyz> ;

  # VIOLATION Distribution_Shape_format_range: URI doesn't match authority/file-type/ pattern
  dct:format <https://example.org/not-eu-file-type/xml> ;

  # VIOLATION Distribution_Shape_rights_range: must be dct:RightsStatement, this is foaf:Agent
  dct:rights <https://example.org/agent/bad> ;

  # VIOLATION Distribution_Shape_applicationLayerProtocol_range: URI doesn't match pattern
  mobilitydcatap:applicationLayerProtocol <https://example.org/fake-protocol/https> ;

  # VIOLATION Distribution_Shape_licence_range: must be dct:LicenseDocument, this is foaf:Agent
  dct:license <https://example.org/agent/bad> ;

  # VIOLATION Distribution_Shape_accessService_range: must be dcat:DataService, this is foaf:Agent
  dcat:accessService <https://example.org/agent/bad> ;

  # VIOLATION Distribution_Shape_communicationMethod_range: URI doesn't match pattern
  mobilitydcatap:communicationMethod <https://example.org/fake-comm/push> ;

  # VIOLATION Distribution_Shape_grammar_range: URI doesn't match pattern
  mobilitydcatap:grammar <https://example.org/fake-grammar/json> ;

  # VIOLATION Distribution_Shape_temporal_range: must be dct:PeriodOfTime, this is foaf:Agent
  dct:temporal <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# KIND - triggers Kind_Shape_*_range
#-----------------------------------------------------------------------------
<https://example.org/kind/bad>
  a vcard:Kind ;
  vcard:fn "Bad Kind" ;
  # VIOLATION Kind_Shape_email_range: must be IRI, this is literal
  vcard:hasEmail "some-email@example.org" ;
  # VIOLATION Kind_Shape_hasURL_range: must be IRI, this is literal
  vcard:hasURL "https://example.org/url-as-string" ;
  # VIOLATION Kind_Shape_hasAddress_range: must be vcard:Address, this is dcat:Dataset
  vcard:hasAddress <https://example.org/dataset/ok> ;
  # VIOLATION Kind_Shape_hasTelephone_range: must be IRI, this is literal
  vcard:hasTelephone "+46-123-456" .


#-----------------------------------------------------------------------------
# LICENCE DOCUMENT - triggers LicenceDocument_Shape_identifier_range
#-----------------------------------------------------------------------------
<https://example.org/licence/bad>
  a dct:LicenseDocument ;
  # VIOLATION LicenceDocument_Shape_identifier_range: must be skos:Concept, this is foaf:Agent
  dct:identifier <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# LOCATION - triggers Location_Shape_inScheme_range
#-----------------------------------------------------------------------------
<https://example.org/location/bad>
  a dct:Location ;
  # VIOLATION Location_Shape_inScheme_range: must be skos:ConceptScheme, this is foaf:Agent
  skos:inScheme <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# MOBILITY DATA STANDARD - triggers MobilityDataStandard_Shape_conformsTo_range
#-----------------------------------------------------------------------------
<https://example.org/mobilitydatastandard/bad>
  a mobilitydcatap:MobilityDataStandard ;
  # VIOLATION MobilityDataStandard_Shape_conformsTo_range: must be skos:Concept, this is foaf:Agent
  dct:conformsTo <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# QUALITY ANNOTATION - triggers QualityAnnotation_Shape_hasTarget_range
#-----------------------------------------------------------------------------
<https://example.org/quality/bad>
  a dqv:QualityAnnotation ;
  # VIOLATION QualityAnnotation_Shape_hasTarget_range: must be dcat:Dataset, this is foaf:Agent
  oa:hasTarget <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# RIGHTS STATEMENT - triggers RightsStatement_Shape_type_range
#-----------------------------------------------------------------------------
<https://example.org/rights/bad>
  a dct:RightsStatement ;
  # VIOLATION RightsStatement_Shape_type_range: must be skos:Concept, this is foaf:Agent
  dct:type <https://example.org/agent/bad> .


#-----------------------------------------------------------------------------
# CATEGORY - triggers Category_Shape_inScheme_range
# (Note: this only fires if your range file uses sh:targetClass skos:Concept
#  as currently written. If narrowed to sh:targetObjectsOf dcat:theme it won't.)
#-----------------------------------------------------------------------------
<https://example.org/category/bad>
  a skos:Concept ;
  skos:prefLabel "Bad Category"@en ;
  # VIOLATION Category_Shape_inScheme_range: must be skos:ConceptScheme, this is foaf:Agent
  skos:inScheme <https://example.org/agent/bad> .
