#---------------------------------------------------------------------------
<https://w3id.org/mobilitydcat-ap/releases/1.1.0/ranges#Location_Shape>
  a sh:NodeShape ;
  sh:targetClass dct:Location ;
  sh:name "Location (mobilityDCAT-AP) - Range Constraints"@en ;
  sh:property
    :Location_Shape_inScheme_range .

:Location_Shape_inScheme_range
