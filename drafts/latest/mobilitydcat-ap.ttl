#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
dct:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/alternative
dct:alternative rdf:type owl:AnnotationProperty .

###  http://purl.org/dc/terms/creator
dct:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/dateCopyrighted
dct:dateCopyrighted rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#backwardCompatibleWith
owl:backwardCompatibleWith rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/depiction
foaf:depiction rdf:type owl:AnnotationProperty .



#################################################################
#    Classes
#################################################################

###  https://w3id.org/mobilitydcatap#MobilityDataStandard
mobilitydcatap:MobilityDataStandard rdf:type owl:Class ;
	rdfs:subClassOf dct:Standard;
    rdfs:comment """The mobility data standard applied for the delivered content. A mobility data standard, e.g., DATEX II, combines syntax and semantic definitions of entities in a certain domain (e.g., for DATEX II: road traffic information), and optionally adds technical rules for data exchange.
    For this entity the following properties are defined: "conforms to (dct:conformsTo)", "title (dct:title)", "version (dcat:version)"."""@en ;
	rdfs:label "Mobility Data Standard"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard> .
		   
### https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address
locn:Address rdf:type owl:Class ;
    rdfs:comment  "A postal address used for agent information."@en ;
    skos:scopeNote """See Address in the Core Location Vocabulary.
    This class corresponds to the addition by geoDCAT-AP v3.0.0.
    For this entity the following properties are defined: "administrative area (locn:adminUnitL2)", "city (locn:postName)", "country (locn:adminUnitL1)", "postal code (locn:postCode)", and "street address (locn:thoroughfare)"."""@en  ;
    rdfs:label "Address (Core Location)"@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Address(CoreLocation)> .

### https://www.w3.org/TR/vcard-rdf/#d4e1292
vcard:Address rdf:type owl:Class ;
    rdfs:comment  "A postal address used for contact point information."@en  ;
    rdfs:label "Address (vCard)"@en ;
    skos:scopeNote """This class corresponds to the addition by geoDCAT-AP v3.0.0.
    For this entity the following properties are defivcard:street-addressed: "administrative area (vcard:region)", "city (vcard:locality)", "country (vcard:country-name)", "postal code (vcard:postal-code)", and "street address (vcard:street-address)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1292> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Address(vCard)> .
		   
###  https://w3id.org/mobilitydcatap#Assessment
mobilitydcatap:Assessment rdf:type owl:Class ;
    rdfs:comment """An assessment procedure by an external organisation. This organisation may be a National Body in the context of EU Delegated Regulations. EU Delegated Regulations require Member States to set up procedures to assess the compliance with the applicable Delegated Regulations, e.g. regarding the provisioning of data via a NAP. These assessment processes are handled by National Bodies and installed individually in each Member State."""@en ;
    rdfs:label "Assessment"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote """The information is optional and needed for the documentation of the assessment procedure. It may be an internal information, only visible for assessment organisations or other authorised users.
    For this entity the following properties are defined: "assessment date (dct:issued)" and "assessment result(oa:hasBody)."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://napcore.eu/national-bodies-3/> .
		   
### https://www.w3.org/TR/vocab-dqv/#dqv:QualityAnnotation
dqv:QualityAnnotation rdf:type owl:Class ;
    rdfs:comment """An annotation about any quality aspects regarding the delivered content, in particular methods, metrics/indicators and results of a quality assessment in the responsibility of the Data Owner."""@en  ;
    rdfs:label "Quality Annotation"@en ;
    skos:scopeNote """There is a similar class  "Quality Measurement" in geoDCAT-AP v3.0.0. Both "Quality Annotation" and "Quality Measurement" are reusing the Data Quality Vocabulary. "Quality Measurement" is referring to concrete metrics, like sub-types of spatial resolutions being used in GeoDCAT-AP. At mobility data portals, however, the practice so far is to provide a more generic quality description, e.g., via a free-text report. Thus, the "Quality Annotation" refers to an unspecified form of quality annotation.
    For this entity the following properties are defined: "quality annotation resource (oa:hasBody)", "quality annotation target (oa:hasTarget)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dqv/#dqv:QualityAnnotation> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#QualityMeasurement> ,
                <https://www.w3.org/TR/vocab-dqv/> .

### https://www.w3.org/TR/vocab-adms/#identifier
adms:Identifier rdf:type owl:Class ;
    rdfs:comment "This is based on the UN/CEFACT Identifier class."@en  ;
    rdfs:label "Identifier"@en ;
    skos:scopeNote """An identifier in a particular context, consisting of the content string that is the identifier;an optional identifier for the identifier scheme; an optional identifier for the version of the identifier scheme; an optional identifier for the agency that manages the identifier scheme. For this entity the following properties are defined: "notation (skos:notation)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-adms/#identifier> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Identifier> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Identifier> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LicenseDocument
dct:LicenseDocument rdf:type owl:Class ;
    rdfs:comment "A legal document, e.g., a concrete license, giving official permission to do something with a resource."@en ;
    skos:scopeNote """This property is used to reference an applicable (standard) licence via an IRI, so a data user can assess the license conditions in machine- and human-readable formats, before using the data.
    Via an instance of this class, a reference to a standard or a organisation-specific license can be given. For standard licenses, a Controlled Vocabulary is provided.
    See the Wiki page on Rights and Licenses for further guidance.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LicenseDocument> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LicenceDocument> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#LicenceDocument> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-standard-licence> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-rights-and-licenses> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Location
dct:Location rdf:type owl:Class ;
    rdfs:comment "A spatial region or named place."@en ;
    skos:scopeNote """It can be represented via a geocode (= a named place) or with geographic coordinates, according to DCAT-AP guidelines. 
    For mobility data portals, usage of geocodes is preferred. Many mobility data providers represent public authorities such as states, regions, municipalities etc., which can be easily represented via named places. In contrast, defining of coordinates per dataset might be error-prone and inconsistent. 
    As geocodes, IRIs from predefined controlled vocabularies such as the EU authority tables, NUTS (Nomenclature des unités territoriales statistiques) or Geonames.org should be used.
    These IRIs can be linked directly from class dct:Location, or indirectly via custom instances of class dct:Location, from the dct:identifier property of this class.
    See the Wiki section for more guidance and code examples on how to use the class dct:Location.
    For this entity the following properties are defined: "bounding box (dcat:bbox)", "centroid (dcat:centroid)", "gazetteer (skos:inScheme)", "geographic identifier (dct:identifier)", "geographic name (skos:prefLabel)", "geometry (locn:geometry)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Location> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Location> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Location> ,
                 <https://joinup.ec.europa.eu/release/how-should-dctspatial-and-dctlocation-be-used> ,
                 <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-spatial> ,
                 <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#5-geographical-coverage> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#PeriodOfTime
dct:PeriodOfTime rdf:type owl:Class ;
    rdfs:comment "An interval of time that is named or defined by its start and end dates."@en ;
    skos:scopeNote """For this entity the following properties are defined: "end date (dcat:endDate)", "start date (dcat:startDate)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#PeriodOfTime> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Periodoftime> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Periodoftime> .


### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#RightsStatement
dct:RightsStatement rdf:type owl:Class ;
    rdfs:comment """A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights."""@en ;
    skos:scopeNote """Reference to concrete (standard) licenses can be provided via another class dct:LicenseDocument.
    See the Wiki page on Rights and Licenses for further guidance.
    For this entity the following properties are defined: "conditions for access and usage dct:type)", "rights statement text (dct:description)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#RightsStatement> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Rightsstatement> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Rightsstatement> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#class-licence-document> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-rights-and-licenses> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard
dct:Standard rdf:type owl:Class ;
    rdfs:comment "A standard or other specification to which a resource conforms."@en ;
    skos:scopeNote """To inform about a mobility data standard applied to the delivered data, mobilityDCAT-AP introduces a separate class mobilitydcatap:MobilityDataStandard. This class mobilitydcatap:MobilityDataStandard is a sub-class of dct:Standard and used as the range of property mobilitydcatap:mobilityDataStandard of class Distribution.
    In contrast, class dct:Standard can be applied to refer to (other or more precise) data standards/specifications/profiles at the Distribution and/or the Mobility Data Standard levels. In such case, this class is used as the range of property dct:conformsTo of class Distribution and/or of property dct:conformsTo of class Mobility Data Standard.
    Class dct:Standard can be also used as the range of property dct:conformsTo of class Catalogue Record.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Standard> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#class-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#distribution-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#distribution-linked-schemas> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#mobility-data-standard-conforms-to> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#catalogue-record-application-profile> .

### https://www.w3.org/2009/08/skos-reference/skos.html#Concept
skos:Concept rdf:type owl:Class ;
    rdfs:comment "An idea or notion; a unit of thought."@en ;
    skos:scopeNote """A Concept is used to denote codes within a codelist. 
    In section 10. Controlled Vocabularies, the expectations are elaborated in more detail.
    For this entity the following properties are defined: "preferred label (skos:prefLabel)", "concept scheme (skos:inScheme)".""" ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/2009/08/skos-reference/skos.html#Concept> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Concept> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Concept> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#controlled-vocabularies> .


### https://www.w3.org/2009/08/skos-reference/skos.html#ConceptScheme
skos:ConceptScheme rdf:type owl:Class ;
    rdfs:comment """An aggregation of one or more SKOS concepts, see class skos:Concept. Semantic relationships (links) between those concepts may also be viewed as part of a concept scheme."""@en ;
    skos:scopeNote """A Concept Scheme is used to denote a codelist.
    In section 10. Controlled Vocabularies, the expectations are elaborated in more detail.
    For this entity the following properties are defined: "title (dct:title)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/2009/08/skos-reference/skos.html#ConceptScheme> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#ConceptScheme> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#controlled-vocabularies> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog
dcat:Catalog rdf:type owl:Class ;
    rdfs:comment """A concrete mobility data portal, i.e, a web portal, where mobility-related datasets and their distributions are described via metadata and discoverable for data users."""@en ;
    skos:scopeNote """For this entity the following properties are defined: "dataset (dcat:dataset)", "description (dct:description)", "geographical coverage (dct:spatial)", "has part (dcat:hasPart)", "homepage (foaf:homepage)", "identifier (dct:identifier)", "language (dct:language)", "licence (dct:licence)", "modification date (dct:modified)", "other identifier (adms:identifier)", "publisher (dct:publisher)", "record (dcat:record)", "release date (dct:issued)", "themes (dcat:themeTaxonomy)", "title (dct:title)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Catalogue> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Catalogue> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record
dcat:CatalogRecord rdf:type owl:Class ;
    rdfs:comment """A description of a metadata entry in the mobility data portal, referring to one dataset and its distributions published on the portal."""@en ;
    skos:scopeNote """mobilityDCAT-AP assumes that metadata records are essential in mobility data portals, so the obligation of this class is raised to "mandatory", comparing to DCAT-AP-v3.0.0.
    For this entity the following properties are defined: "application profile (dct:conformsTo)", "language (dct:language)", "listing date (dct:issued)", "modification date (dct:modified)", "primary topic (foaf:primaryTopic)", "publisher (dct:publisher)", "source metadata (dct:source)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#CatalogueRecord> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset
dcat:Dataset rdf:type owl:Class ;
    rdfs:comment """A dataset is a collection of data, published or curated by a single source, and available for access or download at the mobility data portal in one or more distributions. In the context of mobility-related data exchange, this might be, e.g., a data collection about static parking information for truck drivers, published by a road authority."""@en ;
    skos:scopeNote """For this entity the following properties are defined: "applicable legislation (dcatap:applicableLegislation)", "assessment result (mobilitydcatap:assessmentResult)", "contact point (dcat:contactPoint)", "dataset distribution (dcat:distribution)", "description (dct:description)", "documentation (foaf:page)", "frequency (dct:accrualPeriodicity)", "geographical coverage (dct:spatial)", "georeferencing method (mobilitydcatap:georeferencingMethod)", "has version (dcat:hasVersion)", "identifier (dct:identifier)", "in series (dcat:inSeries)", "intended information service (mobilitydcatap:intendedInformationService)", "keyword (dcat:keyword)", "language (dct:language)", "mobility theme (mobilitydcatap:mobilityTheme)", "modification date (dct:modified)", "network coverage (mobilitydcatap:networkCoverage)", "other identifier (adms:identifier)", "publisher (dct:publisher)", "quality description (dqv:hasQualityAnnotation)", "reference system (geodcatap:referenceSystem)", "related resource (dct:relation)", "release date (dct:issued)", "rights holder (dct:rightsHolder)", "source (dct:source)", "temporal coverage (dct:temporal)", "theme (dcat:theme)", "title (dct:title)", "transport mode (mobilitydcatap:transportMode)", "version (dcat:version)", "version notes (adms:versionNotes)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0-draft/#Dataset> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Dataset> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series
dcat:DatasetSeries rdf:type owl:Class ;
    rdfs:comment """A collection of datasets that are published separately, but share some characteristics that group them."""@en ;
    skos:scopeNote """It is recommended to avoid Dataset Series without a dataset in the collection. Therefore at least one Dataset should refer to a Dataset Series using the property in series (dcat:inSeries).
    Further instructions on the usage of Dataset Series are given in the mobilityDCAT-AP Wikisection on Dataset Series, the DCAT-AP Usage Guide on Dataset Series, and the DCAT-AP Examples for Dataset Series.
    For this entity the following properties are defined: "applicable legislation (dcatap:applicableLegislation)", "contact point (dcat:contactPoint)", "description (dct:description)", "frequency (dct:accrualPeriodicity)", "geographical coverage (dct:spatial)", "mobility theme (mobilitydcatap:mobilityTheme)", "modification date (dct:modified)", "publisher (dct:publisher)", "release date (dct:issued)", "temporal coverage (dct:temporal)", "title (dct:title)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#DatasetSeries> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#DatasetSeries> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-dataset-series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#usage-guide-on-dataset-series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#example-dataset-series> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution
dcat:Distribution rdf:type owl:Class ;
    rdfs:comment """A distribution describes the data formats and communication methods for a dataset. There may be one or multiple distributions for one dataset. For example, the same data set (e.g. static parking information for truck drivers) can be provided in different ways e.g. as downloadable zip file or as XML using a REST web service. These are two distributions based on one dataset."""@en ;
    skos:scopeNote """For the context of mobility data portals, it can be expected that all datasets have one or more distributions. Thus, there must be at least one instance of class Distribution related to one dataset. This is in contrast to DCAT-AP v3.0.0, which allows for datasets without distributions.
    For this entity the following properties are defined: "access url (dcat:accessURL)", "application layer protocol (mobilitydcatap:applicationLayerProtocol)", "applicable legislation (dcatap:applicableLegislation)", "character encoding (cnt:characterEncoding)", "communication method (mobilitydcatap:communicationMethod)", "data format notes (mobilitydcatap:dataFormatNotes)", "description (dct:description)", "documentation (foaf:page)", "download url (dcat:downloadURL)", "format (dct:format)", "language (dct:language)", "licence (dct:license)", "linked schemas (dct:conformsTo)", "mobility data standard (mobilitydcatap:mobilityDataStandard)", "modification date (dct:modified)", "release date (dct:issued)", "rights (dct:rights)", "sample (adms:sample)", "status (adms:status)", "temporal coverage (dct:temporal)", "title (dct:title)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Distribution> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Distribution> .


### http://xmlns.com/foaf/spec#term_Agent
foaf:Agent rdf:type owl:Class ;
    rdfs:comment """An entity (e.g., an individual or an organisation) that is associated with Catalogues, Catalogue Records, Datasets, or Dataseries."""@en ;
    skos:scopeNote """According to [FOAF], an Agent may be of a type of a person (via sub-class foaf:Person), an organisation (via sub-class foaf:Organization), or a group (via sub-class foaf:Group).
    For mobility data portals, it is expected that organisations are the main data actors, so the type organisation is preferred. In such case, the use of the Organization Ontology is recommended.
    If a person is mentioned as an agent, he or she should be attributed to an organisation via the property org:memberOf, and, additionally, attributed with the personal name via properties foaf:firstName and foaf:surname.
    The agent might be populated with the same information as for a kind, see class vcard:Kind.
    When providing agent information, data publishers should prioritize organizational information over personal details. The exposure of personal information, such as a personal name and email address, may be restricted to the public. Instead, there might be an anonymous contact channel, e.g. a contact button on the GUI that triggers an email to the agent. See 12. Privacy and security considerations.
    See also the Wiki page with more recommendations on the usage of organisational and personal information.

    For this entity the following properties are defined: address, affiliation, email, first name, name, phone, surname, type, URL."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec#term_Agent> ,
                <https://www.w3.org/TR/vocab-org/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#agent-roles> ,
                <https://www.w3.org/TR/vocab-dcat-3/#Class:Organization_Person> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Agent> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Agent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#privsec> .

### http://xmlns.com/foaf/spec/#term_Document
foaf:Document rdf:type owl:Class ;
    rdfs:comment """A textual resource intended for human consumption that contains information, e.g. a web page about a Dataset.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec/#term_Document> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Document> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Document> .

### https://www.w3.org/TR/vcard-rdf/#d4e1588
vcard:Email rdf:type owl:Class ;
    rdfs:comment """The electronic mail address for communication with the object.
    See Email in the VCard Ontology.
    This class corresponds to the addition by geoDCAT-AP v3.0.0.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1588> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Email(vCard)> ,
                <https://www.w3.org/2006/vcard/ns#Email> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Frequency
dct:Frequency rdf:type owl:Class ;
    rdfs:comment """A rate at which something recurs, e.g., the update rate of a dataset.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Frequency> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Frequency> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Frequency> .

### http://data.europa.eu/eli/ontology#LegalResource
eli:LegalResource rdf:type owl:Class ;
    rdfs:comment """The legislation, policy or policies that lie behind the rules that govern the service.
    The definition and properties of the Legal Resource class are aligned with the ontology included in "Council conclusions inviting the introduction of the European Legislation Identifier (ELI)". For describing the attributes of a Legal Resource (labels, preferred labels, alternative labels, definition, etc.) we refer to the ELI ontology. In this data specification the use is restricted to instances of this class that follow the ELI URI guidelines.
    This specification does not impose any additional requirements to properties for this entity,"""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <http://data.europa.eu/eli/ontology#LegalResource> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LegalResource> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#LegalResource> ,
                <https://eur-lex.europa.eu/eli-register/about.html> ,
                <https://op.europa.eu/en/web/eu-vocabularies/eli> .

### https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry
locn:Geometry rdf:type owl:Class ;
    rdfs:comment """The means to identify a location as a point, line, polygon, etc. expressed using coordinates in some coordinate reference system.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Geometry> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Geometry> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LinguisticSystem
dct:LinguisticSystem rdf:type owl:Class ;
    rdfs:comment """A system of signs, symbols, sounds, gestures, or rules used in communication, e.g. a language.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LinguisticSystem> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Linguisticsystem> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Linguisticsystemt> .

### https://www.w3.org/TR/vcard-rdf/#d4e1819
vcard:Kind rdf:type owl:Class ;
    rdfs:comment """A description following the VCARD-RDF specification, e.g. to provide telephone number and e-mail address for a contact point.
    This class is the parent class for the four explicit types of vCards (vcard:Individual, vcard:Organization, vcard:Location, vcard:Group).
    The contact point might be populated with the same information as for an agent, see class foaf:Agent. See 11. Agent Types, Agent Roles and Contact Information for further usage notes on that matter.
    When providing contact information, data publishers SHOULD prioritize organizational information over personal details. The exposure of personal information, such as a personal name and email address, may be restricted to the public. Instead, there might be an anonymous contact channel, e.g. a contact button on the GUI that triggers an email to the agent. See 13. Privacy and security considerations.
    For this entity the following properties are defined: "address (vcard:hasAddress)", "affiliation(vcard:organization-name)", "email(vcard:hasEmail)", "name (vcard:fn)", "phone (vcard:hasTelephone)", "URL (vcard:hasURL)"."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1819> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Kind> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Kind> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1749> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e2121> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1865> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1667> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#class-agent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#agent-roles> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#privsec> .

### https://www.w3.org/TR/rdf11-schema/#ch_literal
rdfs:Literal rdf:type owl:Class ;
    rdfs:comment """A literal value such as a string or integer. Literals may be typed, e.g. as a date according to xsd:date. Literals that contain human-readable text have an optional language tag as defined by BCP 47 rfc5646.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-schema/#ch_literal> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Literal> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Literal> ,
                <https://datatracker.ietf.org/doc/html/rfc5646> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#MediaTypeOrExtent
dct:MediaTypeOrExtent rdf:type owl:Class ;
    rdfs:comment """A media type or extent.
    In mobilityDCAT-AP, this class is only used as the range of property dct:format for class Distribution.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#MediaTypeOrExtent> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#MediaTypeorExtent> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#MediaTypeorExtent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#distribution-format> .

### https://www.w3.org/ns/org#Organization
org:Organization rdf:type owl:Class ;
    rdfs:comment """Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures.
    See Organization in The Organization Ontology.
    This class corresponds to the addition by geoDCAT-AP v3.0.0.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/ns/org#Organization> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Organisation> ,
                <https://www.w3.org/TR/vocab-org/#org:Organization> .

### https://www.w3.org/TR/rdf11-schema/#ch_resource
rdfs:Resource rdf:type owl:Class ;
    rdfs:comment """Anything described by RDF.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-schema/#ch_resource> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Resource> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Resource> .


#################################################################
#    Properties
#################################################################

###  http://www.w3.org/ns/locn#address
locn:address a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The postal address of the agent. 
    This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "address"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agent."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes foaf:Agent ;
    dcam:rangeIncludes locn:Address ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#address> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://www.w3.org/ns/org#memberOf
org:memberOf a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The affiliation of the agent. This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "affiliation"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agent."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes foaf:Agent ;
    dcam:rangeIncludes org:Organization ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-org/#org:memberOf> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
		   
###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox a rdf:Property,
	owl:ObjectProperty ;
    rdfs:comment """The email address of the agent, specified using fully qualified mailto: URI scheme RFC6068. This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "email"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agent."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes foaf:Agent ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/mbox> ,
                <https://www.rfc-editor.org/rfc/rfc6068> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://xmlns.com/foaf/0.1/phone
foaf:phone a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The phone number of the agent, specified using fully qualified tel: URI scheme RFC3966. This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "phone"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agent."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes foaf:Agent ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/phone> ,
                <https://www.rfc-editor.org/rfc/rfc3966> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://xmlns.com/foaf/0.1/workplaceHomepage
foaf:workplaceHomepage a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The Web site of the agent.
    This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "URL"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agent."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes foaf:Agent ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/#term_workplaceHomepage> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .

###   https://www.w3.org/TR/annotation-vocab/#hasbody
oa:hasBody a rdf:Property ; # mixed range (Resource or Literal); intentionally untyped as Object/DatatypeProperty
    rdfs:comment """For Assessment, this property indicates the result of the latest assessment procedure, in form of a URL linking to further details or results. Alternatively, textual information is provided using the Embedded Textual Body construction of the Web Annotation Data Model, which allows to specify text formats and languages which might be relevant for multilingual purposes.

    For Quality Annotation, this property contains any quality aspects regarding the delivered content, in form of a URL linking to further details or results, or textual information.
    Textual information should be provided using the Embedded Textual Body construction of the Web Annotation Data Model, which allows to specify text formats and languages which might be relevant for multilingual purposes."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Assessment and Quality Annotation. "@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes mobilitydcatap:Assessment ,
                        dqv:QualityAnnotation ;
    dcam:rangeIncludes rdfs:Resource ,
                       rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/annotation-vocab/#hasbody> ,
                <https://www.w3.org/TR/annotation-model/> .


###   http://www.w3.org/ns/adms#identifier
adms:identifier a rdf:Property,
    owl:ObjectProperty ;
    rdfs:label "other identifier"@en ;
    rdfs:comment """For Catalogue, this property may be used as an additional identifier, besides dct:identifier.
    This property may be referring to a dedicated, EU-wide identifier system of NAPs or other portals, to be introduced in the future.
    This property is an addition by mobilityDCAT-AP.

    For Dataset, This property may be used as an additional identifier, besides dct:identifier.This property may be referring to a dedicated, EU-wide identifier system of NAP datasets, to be introduced in the future, or other identifier systems such as DataCite, DOI, or W3ID."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogue and Dataset. "@en ;   
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:Dataset ;
    dcam:rangeIncludes adms:Identifier ;
    rdfs:seeAlso <http://www.w3.org/ns/adms#identifier> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#catalogue-identifier> ,
                <https://schema.datacite.org/> ,
                <http://www.doi.org/> ,
                <https://w3id.org/> .
           			   			   
		   
### http://purl.org/dc/terms/publisher
dct:publisher a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Catalogue, this property refers an entity (an organisation or a person), which is responsible for creation and maintenance of the metadata entry on the data platform. This entity is the direct contact for the data platform operators or data-searching users, who have questions or issues about the metadata entry.
    This information can be natively created by a data platform, corresponding to the entity that is registered to the data platform and has the role of a metadata creator. This information can be also harvested from other portals. The information might be identical to the property dct:publisher of the corresponding dataset.
    This property corresponds to the addition by GEODCAT-AP-v3.0.0.

    For Catalogue Record, this property refers to an entity (an organisation or a person), which is responsible for creation and maintenance of the metadata entry on the data platform. This entity is the direct contact for the data platform operators or data-searching users, who have questions or issues about the metadata entry.
    This information can be natively created by a data platform, corresponding to the entity that is registered to the data platform and has the role of a metadata creator. This information can be also harvested from other portals. The information might be identical to the property dct:publisher of the corresponding dataset.
    This property corresponds to the addition by GEODCAT-AP-v3.0.0.

    For Dataset, this property refers to an entity (company and person) that publishes the dataset. This entity is responsible for the provisioning of a dataset. The entity also concludes a contract, if applicable.
    This information can be natively created by a data platform, then corresponding to the entity that is registered to the data platform and has the role of a data publisher. The information might be identical to the property dct:publisher of class Catalogue Record and/or dct:rightsHolder of class Dataset.
    To establish a contact with a company or person responsible for the dataset, the property dcat:contactPoint should be used.
    However, the publisher and the contact point might be populated with the same information. See 11. Agent Types, Agent Roles and Contact Information for further usage notes on that matter.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0.

    For Dataset Series, it refers to an entity (company and person) that publishes the dataset series. This entity is also responsible for ensuring the coherency of the dataset series.
    The publisher of the dataset series may or may be not the publisher of all datasets, as declared via property dct:publisher. E.g. a digital archive could take over the publishing of older datasets in the series.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0."""@en ;
    rdfs:label "publisher"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogue, Dataset, and Dataset Series; and it is an optional property to be used for Catalogue Record."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:CatalogRecord ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ;
    dcam:rangeIncludes foaf:Agent ;
    rdfs:seeAlso <http://purl.org/dc/terms/publisher> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-publisher> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#catalogue-record-publisher> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-rights-holder> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-contact-point> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#agent-roles> .


###  http://purl.org/dc/terms/source
dct:source a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Catalogue Records, it refers to the original metadata record that was used in creating the metadata record.
    Used for metadata records that are harvested from other portals. Harvesting, i.e., the automated import of metadata information from external portals, seems to be a common case for some NAPs. With these property, a data user can see, if the metadata was harvested, and from where. The property should link to a public URL of the dataset description on the original data portal, from where the metadata was harvested.

    For Datasets, it refers to a related Dataset from which the described Dataset is derived.
    There is the same property dct:source on the Catalogue Record level. The source of a dataset relates to the content data, whereas the source of a catalogue record relates to the metadata."""@en ;
    rdfs:label "source metadata"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogue Record and Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:CatalogRecord ,
                        dcat:Dataset ;
    dcam:rangeIncludes dcat:CatalogRecord ,
                       dcat:Dataset ;
    rdfs:seeAlso <http://purl.org/dc/terms/source> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#catalogue-record-source-metadata> .	

###  https://www.w3.org/2009/08/skos-reference/skos.html#inScheme
skos:inScheme a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Location, it refers to the gazetteer, i.e., a codelist to which the location belongs.
    This property corresponds to the addition by geoDCAT-AP v3.0.0.

    For Concept, relates a concept to a concept scheme in which it is included.
    This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Location and Concept."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes skos:Concept ,
                        dct:Location ;
    dcam:rangeIncludes skos:ConceptScheme ;
    rdfs:seeAlso <https://www.w3.org/2009/08/skos-reference/skos.html#inScheme> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .     
		   
###  https://w3id.org/mobilitydcat-ap#mobilityTheme
mobilitydcatap:mobilityTheme a rdf:Property,
    owl:ObjectProperty ;
	rdfs:subPropertyOf dcat:theme ;
    rdfs:comment """For Dataset, this property refers to the mobility-related theme (i.e., a specific subject, category, or type) of the delivered content. A dataset may be associated with multiple themes. A theme is important for data seekers who are interested in a particular type of data content.
    The theme is described via a controlled vocabulary in two hierarchy levels: The 1st level is a mandatory field labelled "Data content category", describing the classification of the data content on an aggregated level. The 2nd level is an optional field labelled “Data content sub category”, detailing the "Data content category" via one or several sub-categories. When entering the metadata for one dataset, the data provider would first select one or several options of a "Data content category", and then optionally details this with one or more options of corresponding “Data content sub category”. The platform must be able to handle the dependencies between these two levels, i.e., match the allowed options between the 1st and 2nd level.
    A corresponding controlled vocabulary is provided.
    This property is a sub-property of dcat:theme, being a further property of Dataset. To distinguish these two theme properties, it is recommended to label mobilitydcatap:mobilityTheme as "Mobility Theme", and dcat:theme as "EU Open Data Theme".
    The subject of a dataset may also be described via property dcat:keyword. However, the usage of "mobility theme" is preferred, to avoid ambiguity and uncontrolled theme descriptions.

    For Dataset Series, this property refers to the mobility-related theme (i.e., a specific subject, category, or type) of the dataset series. A theme is important for data seekers who are interested in a particular type of data content. It is recommended that the theme does not change among datasets in the collection, i.e., the theme of the dataset series should be equal to the theme of each dataset in the collection.
    A corresponding controlled vocabulary is provided."""@en ;
    rdfs:label "mobility theme"@en  ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for  Dataset; and it is an optional property to be used with Dataset Series."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ,
                        dcat:DatasetSeries ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#mobilityTheme> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-mobility-theme> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-theme> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-keyword> .

###  https://w3id.org/mobilitydcat-ap#georeferencingMethod
mobilitydcatap:georeferencingMethod a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The georeferencing method used in the delivered content.
    A corresponding controlled vocabulary is provided, denoting commonly used georeferencing methods for mobility data."""@en ;
    rdfs:label "georeferencing method"@en  ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-georeferencing-method> .

		   
###  https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#conformsTo
dct:conformsTo a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Catalogue Record, this property refers to an Application Profile that the catalogued resource's metadata conforms to. In particular, specify which mobilityDCAT-AP version is used to describe the metadata.
    As the range, it is recommended to use the mobilityDCAT-AP IRI with versioning, e.g., "https://w3id.org/mobilitydcat-ap/releases/1.1.0". The value may be generated automatically by the NAP system, corresponding to the currently used mobilityDCAT-AP version.

    For Distribution, it refers to an established schema to which the described Distribution conforms.
    To inform about a mobility data standard (and also related profiles) applied to the delivered data, property mobilitydcatap:mobilityDataStandard should be preferably used. In addition, property dct:conformsTo can be used to serve the needs of standard DCAT/DCAT‑AP open data portals. Such portals usually cannot process information exposed indirectly via property mobilitydcatap:mobilityDataStandard, i.e., they cannot dereference or validate such references. Thus, this property would expose the standards/profiles information directly at the Distribution.

    For Mobility Data Standard, it refers to the reference to the applied mobility data standard, as well as to individual/national/content-specific profiles or representations of the applied standard.
    This property is necessary if a custom instance of class mobilitydcatap:MobilityDataStandard is defined. This property would then reference a common mobility data standard (e.g., "NeTeX" via the controlled vocabulary), as well as additionally further individual/national/content-specific profiles or representations of the applied standard (e.g., an Italian NeTEx profile)."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogue Record, Distribution, and Mobility Data Standard. "@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:CatalogRecord ,
                        dcat:Distribution ,
                        mobilitydcatap:MobilityDataStandard ;
    dcam:rangeIncludes dct:Standard ,
                       skos:Concept ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#conformsTo> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#distribution-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#class-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-mobility-data-standard> .

###  http://purl.org/dc/terms/rightsHolder
dct:rightsHolder a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """An entity that legally owns or holds the rights of the data provided in a dataset. This entity is legally responsible for the content of the data and (if applicable) for the relevance to legal frameworks (see property dcatap:applicableLegislation.
    The rights holder will be in many cases identical with the publisher of the dataset (see property dct:publisher) and/or of the catalogue record (see property dct:publisher). In such case, the rights holder data may be copied from the corresponding publisher entries. There might be also cases with non-identical entities: e.g., when one or several rights holders contract a third-party publisher (e.g., an IT service company), which is producing, hosting and publishing a dataset.
    This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "rights holder"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets. "@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes foaf:Agent ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#rightsHolder> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-applicable-legislation> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-publisher> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#catalogue-record-publisher> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .

###  https://w3id.org/mobilitydcat-ap#networkCoverage
mobilitydcatap:networkCoverage a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property describes the part of the transport network that is covered by the delivered content.
    For road traffic, the property should refer to the network classification for which the data is provided. As a minimum, an international or higher-level classification, e.g., via functional road classes, is recommended to allow data search across different countries. In addition, national classifications are allowed.
    For other transport modes, the property is meant to refer to the physical infrastructure which is used by the services covered by the data.
    For all modes, the property should also indicate if the data content relates to the EU’s trans-European transport network.
    A corresponding controlled vocabulary is provided, denoting commonly used road and infrastructure network classes."""@en ;
    rdfs:label "network coverage"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#networkCoverage> , 
                <https://transport.ec.europa.eu/transport-themes/infrastructure-and-investment/trans-european-transport-network-ten-t_en> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-georeferencing-method> .

		   
###  https://w3id.org/mobilitydcat-ap#transportMode
mobilitydcatap:transportMode a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The transport mode that is covered by the delivered content.
    A corresponding controlled vocabulary is provided, denoting commonly used transport modes."""@en ;
    rdfs:label "transport mode"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#transportMode> , 
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-transport-mode> .
		   
###  http://data.europa.eu/r5r/applicableLegislation
dcatap:applicableLegislation a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Dataset, it describes a legal framework being relevant for the dataset, e.g., an EC Delegated Regulation which stipulates the provisioning of the corresponding dataset, or some other international or national frameworks, e.g., Open Data regulations.
    
    For Dataset Series, it refers to a legal framework being relevant for the dataset series.

    For Distribution, it contains information about a legal framework being relevant for the distribution.
    The legal framework is usually provided on the dataset level, see property dcatap:applicableLegislation. However, there is a special case of if a High Value Dataset (HVD) is provided on a portal. Here, the DCAT-AP profile for HVD stipulates that this property links to the EC regulation 2013/138 on HVD both on the dataset and distribution levels. In other words, a RDF statement is required under the dataset and distribution class, if a HVD is published on the portal. For other cases outside HVD, the use of this property is not recommended."""@en ;
    rdfs:label "applicable legislation"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset, Dataset Series and Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ,
                        dcat:DatasetSeries ,
                        dcat:Distribution ;
    dcam:rangeIncludes eli:LegalResource ;
    rdfs:seeAlso <http://data.europa.eu/r5r/applicableLegislation>  ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#dataset-applicable-legislation> ,
                <https://semiceu.github.io/uri.semic.eu-generated/DCAT-AP/releases/2.2.0-hvd/> ,
                <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:32023R0138> .


###  https://w3id.org/mobilitydcat-ap#assessmentResult
mobilitydcatap:assessmentResult a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY refer to the results and outcomes from an assessment process by some organisation, e.g., a National Body in the context of EU Delegated Regulations. EU Delegated Regulations require Member States to set up procedures to assess the compliance of the Delegated Regulations, e.g. regarding the provisioning of data via a NAP. These assessment processes are handled by National Bodies [NAPCORE-NB] and installed individually in each Member State. The property MAY point to the most recent assessment procedure, including its date, its result as a free-text and/or a link referring to an assessment report online. The difference to the property dqv:hasQualityAnnotation is that the latter one is provided by the data provider, while the assessment results are provided by an external organisation."""@en ;
    rdfs:label "assessment result"@en  ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes mobilitydcatap:Assessment ;
    rdfs:seeAlso <https://napcore.eu/national-bodies/> .
		   
###  https://w3id.org/mobilitydcat-ap#intendedInformationService
mobilitydcatap:intendedInformationService a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """A type of information service, which the data content is intended to support. Such services may be, e.g., information services for multimodal mobility, as specified by EC Delegated Regulation 2024/490.
    Examples of such services include “location search”, which is based on a datasets with address identifiers, or “trip plan computation”, which is based on datasets on timetables.
    A corresponding controlled vocabulary is provided."""@en ;
    rdfs:label "intended information service"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;		
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#intendedInformationService> ,
                <https://eur-lex.europa.eu/eli/reg_del/2024/490/oj/eng> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-information-service> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-intended-information-service> .
 		   
###  http://www.w3.org/ns/dqv#hasQualityAnnotation
dqv:hasQualityAnnotation a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """Any quality aspects regarding the delivered content, in particular methods, metrics/indicators and results of a quality assessment. This information should assist data consumers in determining the value of data, before actually accessing and processing it. Thus, the information should be publicly available. Furthermore, it can be helpful for validation processes by 3rd parties, e.g., a National Body in context of EU Delegated Regulations.
    Quality aspects should be noted via a free text and/or via URLs linking to further quality information. If there is absolutely no quality information, at least a note “quality information is unknown” should be given.
    If existing quality frameworks have been applied in the quality assessment, e.g., the Quality Frameworks from the NAPCORE project, these frameworks should be referenced."""@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dqv:QualityAnnotation ;
    rdfs:seeAlso <http://www.w3.org/ns/dqv#hasQualityAnnotation> ,
                <https://napcore.eu/quality/> .


###  https://w3id.org/mobilitydcat-ap#mobilityDataStandard
mobilitydcatap:mobilityDataStandard a rdf:Property,
    owl:ObjectProperty ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment """mobilitydcatap:mobilityDataStandardThe mobility data standard, as applied for the delivered content within the distribution. A mobility data standard, e.g., DATEX II, combines syntax and semantic definitions of entities in a certain domain (e.g., for DATEX II: road traffic information), and optionally adds technical rules for data exchange.
    This is a sub-property of dct:conformsTo.

    A corresponding controlled vocabulary is provided, listing common mobility data standards. At least one value from this controlled vocabulary is required. If no suitable standard is found in this vocabulary, the "other" entry should be used.
    Optionally, a new individual instance of class mobilitydcatap:MobilityDataStandard can be provided. This instance might be used to (a) reference a mobility data standard that is not listed in the controlled vocabulary; or (b) provide additional information on an applied mobility data standard (even if listed in the controlled vocabulary), such as version or schema details. See the Wiki page for a code example with a reference to a mobility data standard (listed in the controlled vocabulary), and detailed information via an individual instance of class mobilitydcatap:MobilityDataStandard."""@en ;
    rdfs:label "mobility data standard"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes mobilitydcatap:MobilityDataStandard ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#mobilityDataStandard> ,
                <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#conformsTo> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-mobility-data-standard> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#4-mobility-data-standard> .

		   
###  https://w3id.org/mobilitydcat-ap#applicationLayerProtocol
mobilitydcatap:applicationLayerProtocol a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The transmitting channel, i.e., the Application Layer Protocol, of the distribution.
    A corresponding controlled vocabulary is provided."""@en ;
    rdfs:label "application layer protocol"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this property is an optional property to be used for Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#applicationLayerProtocol> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-application-layer-protocol> .
		   
###  https://w3id.org/mobilitydcat-ap#communicationMethod
mobilitydcatap:communicationMethod a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """Indicates for dynamically provided distributions, e.g., data feeds, if the data interface of the data provider system functions in a push or pull mode.
    A corresponding controlled vocabulary is provided."""@en ;
    rdfs:label "communication method"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://w3id.org/mobilitydcat-ap#communicationMethod> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-communication-method> .

###  https://w3id.org/mobilitydcat-ap#grammar
mobilitydcatap:grammar a owl:ObjectProperty ;
    owl:deprecated true ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment """This property is deprecated."""@en ;
    rdfs:label "grammar"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    skos:scopeNote "In mobilityDCAT-AP, this property is deprecated."@en ;
    vs:term_status "deprecated" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/DEPRECATED> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept .


###  http://www.w3.org/ns/adms#sample
adms:sample a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """A sample of the delivered content, using the same conditions (e.g., the same format and licence) as the regular disctribution. A sample allows data users to investigate the data content and data structure, without subscribing to a data feed or downloading a complete data set.
    In DCAT-AP v3.0.0, there is a property adms:sample under class Dataset, with class Distribution as the range. This implies that all mandatory properties for a distribution, e.g., the applied Mobility Data Standard, must be applied for a sample. To simplify the description of the sample, mobilityDCAT-AP recommends to describe the sample via a property under class Distribution, instead under class Dataset."""@en ;
    rdfs:label "sample"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-adms/#adms-sample> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Dataset.sample> .

###  https://www.w3.org/ns/legacy_adms#status
adms:status a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The status of the distribution in the context of maturity lifecycle.
    It must take one of the values Completed, Deprecated, Under Development, Withdrawn. A corresponding controlled vocabulary is provided."""@en ;
    rdfs:label "status"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://www.w3.org/ns/legacy_adms#status> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/#vocab-status> .

###  http://purl.org/dc/terms/temporal
dct:temporal a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Dataset, this property refers to a temporal period, i.e., the beginning and the end, of the time reference of the delivered content (e.g., validity time of a public-transport time table).

    For Dataset Series, it refers to atemporal period, i.e., the beginning and the end, of the time reference that the Dataset Series covers.
    When temporal coverage is a dimension in the dataset series then the temporal coverage of each dataset in the collection should be part of the temporal coverage. In that case, an open ended value is recommended, e.g. "after 2012".

    For Distribution, it refers to a time interval when a distribution is facilitated (i.e., activated) technically via the data platform. Might be used if data access via a distribution is limited in time.
    If there is no entry it means that the distribution has no explicit start time (i.e., it is facilitated immediately) and has no end time (i.e., it is facilitated infinitely)."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Dataset, Dataset Series and Distribution."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ;
    dcam:rangeIncludes dct:PeriodOfTime ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#temporal> .


###  https://www.w3.org/TR/vcard-rdf/#d4e1157
vcard:region a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The administrative area of an address. Depending on the country, this corresponds to a province, a county, a region, or a state.
    This property corresponds to the addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "administrative area"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Address (vCard)."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1157> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .

