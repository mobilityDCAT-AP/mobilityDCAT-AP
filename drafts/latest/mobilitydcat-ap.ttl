#################################################################
#    Classes
#################################################################

###  https://w3id.org/mobilitydcatap#MobilityDataStandard
mobilitydcatap:MobilityDataStandard rdf:type owl:Class ;
	rdfs:subClassOf dct:Standard;
    rdfs:comment """The mobility data standard applied for the delivered content. A mobility data standard, e.g., DATEX II, combines syntax and semantic definitions of entities in a certain domain (e.g., for DATEX II: road traffic information), and optionally adds technical rules for data exchange.
    For this entity the following properties are defined: "conforms to (dct:conformsTo)", "title (dct:title)", "version (dcat:version)"."""@en ;
	rdfs:label "Mobility Data Standard"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard> .
		   
### https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address
locn:Address rdf:type owl:Class ;
    rdfs:comment  """A postal address used for agent information.
    See Address in the Core Location Vocabulary.
    This class is analogue to an addition by geoDCAT-AP v3.0.0.
    For this entity the following properties are defined: "administrative area (locn:adminUnitL2)", "city (locn:postName)", "country (locn:adminUnitL1)", "postal code (locn:postCode)", and "street address (locn:thoroughfare)"."""@en  ;
    rdfs:label "Address (Core Location)"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <hhttps://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Address(CoreLocation)> ,
                <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Address> .

### https://www.w3.org/TR/vcard-rdf/#d4e1292
vcard:Address rdf:type owl:Class ;
    rdfs:comment  """A postal address used for contact point information.
    This class is analogue to an addition by geoDCAT-AP v3.0.0.
    For this entity the following properties are defined: "administrative area (vcard:region)", "city (vcard:locality)", "country (vcard:country-name)", "postal code (vcard:postal-code)", and "street address (vcard:street-address)"."""@en  ;
    rdfs:label "Address (vCard)"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1292> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Address(vCard)> .
		   
###  https://w3id.org/mobilitydcatap#Assessment
mobilitydcatap:Assessment rdf:type owl:Class ;
    rdfs:comment """An assessment procedure by an external organisation. This organisation may be a National Body in the context of EU Delegated Regulations. EU Delegated Regulations require Member States to set up procedures to assess the compliance with the applicable Delegated Regulations, e.g. regarding the provisioning of data via a NAP. These assessment processes are handled by National Bodies and installed individually in each Member State. 
    The information is optional and needed for the documentation of the assessment procedure. It may be an internal information, only visible for assessment organisations or other authorised users.
    For this entity the following properties are defined: "assessment date (dct:issued)" and "assessment result(oa:hasBody)" """@en ;
    rdfs:label "Assessment"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://napcore.eu/national-bodies-3/> .
		   
### https://www.w3.org/TR/vocab-dqv/#dqv:QualityAnnotation
dqv:QualityAnnotation rdf:type owl:Class ;
    rdfs:comment """An annotation about any quality aspects regarding the delivered content, in particular methods, metrics/indicators and results of a quality assessment in the responsibility of the Data Owner. 
    There is a similar class  "Quality Measurement" in geoDCAT-AP v3.0.0. Both "Quality Annotation" and "Quality Measurement" are reusing the Data Quality Vocabulary. "Quality Measurement" is referring to concrete metrics, like sub-types of spatial resolutions being used in GeoDCAT-AP. At mobility data portals, however, the practice so far is to provide a more generic quality description, e.g., via a free-text report. Thus, the "Quality Annotation" refers to an unspecified form of quality annotation.
    For this entity the following properties are defined: "quality annotation resource (oa:hasBody)", "quality annotation target (oa:hasTarget)"."""@en  ;
    rdfs:label "Quality Annotation"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dqv/#dqv:QualityAnnotation> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#QualityMeasurement> ,
                <https://www.w3.org/TR/vocab-dqv/> .

### https://www.w3.org/TR/vocab-adms/#identifier
adms:Identifier rdf:type owl:Class ;
    rdfs:comment """This is based on the UN/CEFACT Identifier class.
    An identifier in a particular context, consisting of the content string that is the identifier;an optional identifier for the identifier scheme; an optional identifier for the version of the identifier scheme; an optional identifier for the agency that manages the identifier scheme. For this entity the following properties are defined: "notation (skos:notation)"."""@en  ;
    rdfs:label "Identifier"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-adms/#identifier> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Identifier> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Identifier> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LicenseDocument
dct:LicenseDocument 
    rdfs:comment """A legal document, e.g., a concrete license, giving official permission to do something with a resource.
    This property is used to reference an applicable (standard) licence via an IRI, so a data user can assess the license conditions in machine- and human-readable formats, before using the data.
    Via an instance of this class, a reference to a standard or a organisation-specific license can be given. For standard licenses, a Controlled Vocabulary is provided.
    See the Wiki page on Rights and Licenses for further guidance.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended class."@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LicenseDocument> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LicenceDocument> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#LicenceDocument> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-standard-licence> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-rights-and-licenses> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Location
dct:Location 
    rdfs:comment """A spatial region or named place. 
    It can be represented via a geocode (= a named place) or with geographic coordinates, according to DCAT-AP guidelines. 
    For mobility data portals, usage of geocodes is preferred. Many mobility data providers represent public authorities such as states, regions, municipalities etc., which can be easily represented via named places. In contrast, defining of coordinates per dataset might be error-prone and inconsistent. 
    As geocodes, IRIs from predefined controlled vocabularies such as the EU authority tables, NUTS (Nomenclature des unités territoriales statistiques) or Geonames.org should be used.
    These IRIs can be linked directly from class dct:Location, or indirectly via custom instances of class dct:Location, from the dct:identifier property of this class.
    See the Wiki section for more guidance and code examples on how to use the class dct:Location.
    For this entity the following properties are defined: "bounding box (dcat:bbox)", "centroid (dcat:centroid)", "gazetteer (skos:inScheme)", "geographic identifier (dct:identifier)", "geographic name (skos:prefLabel)", "geometry (locn:geometry)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Location> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Location> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Location> ,
                 <https://joinup.ec.europa.eu/release/how-should-dctspatial-and-dctlocation-be-used> ,
                 <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-spatial> ,
                 <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#5-geographical-coverage> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#PeriodOfTime
dct:PeriodOfTime 
    rdfs:comment """An interval of time that is named or defined by its start and end dates.
    For this entity the following properties are defined: "end date (dcat:endDate)", "start date (dcat:startDate)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended class."@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#PeriodOfTime> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Periodoftime> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Periodoftime> .


### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#RightsStatement
dct:RightsStatement 
    rdfs:comment """A statement about the intellectual property rights (IPR) held in or over a resource, a legal document giving official permission to do something with a resource, or a statement about access rights. 
    Reference to concrete (standard) licenses can be provided via another class dct:LicenseDocument.
    See the Wiki page on Rights and Licenses for further guidance.
    For this entity the following properties are defined: "conditions for access and usage dct:type)", "rights statement text (dct:description)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#RightsStatement> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Rightsstatement> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Rightsstatement> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#class-licence-document> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-rights-and-licenses> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard
dct:Standard 
    rdfs:comment """A standard or other specification to which a resource conforms.
    To inform about a mobility data standard applied to the delivered data, mobilityDCAT-AP introduces a separate class mobilitydcatap:MobilityDataStandard. This class mobilitydcatap:MobilityDataStandard is a sub-class of dct:Standard and used as the range of property mobilitydcatap:mobilityDataStandard of class Distribution.
    In contrast, class dct:Standard can be applied to refer to (other or more precise) data standards/specifications/profiles at the Distribution and/or the Mobility Data Standard levels. In such case, this class is used as the range of property dct:conformsTo of class Distribution and/or of property dct:conformsTo of class Mobility Data Standard.
    Class dct:Standard can be also used as the range of property dct:conformsTo of class Catalogue Record.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Standard> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Standard> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#class-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#distribution-mobility-data-standard> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#distribution-linked-schemas> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#mobility-data-standard-conforms-to> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#catalogue-record-application-profile> .

### https://www.w3.org/2009/08/skos-reference/skos.html#Concept
skos:Concept 
    rdfs:comment """An idea or notion; a unit of thought.
    A Concept is used to denote codes within a codelist. 
    In section 10. Controlled Vocabularies, the expectations are elaborated in more detail.
    For this entity the following properties are defined: "preferred label (skos:prefLabel)", "concept scheme (skos:inScheme)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class when referring to Category; and it is an optional class when referring to Publisher type or Status." ;
    rdfs:seeAlso <https://www.w3.org/2009/08/skos-reference/skos.html#Concept> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Concept> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Concept> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#controlled-vocabularies> .


### https://www.w3.org/2009/08/skos-reference/skos.html#ConceptScheme
skos:ConceptScheme 
    rdfs:comment """An aggregation of one or more SKOS concepts, see class skos:Concept. Semantic relationships (links) between those concepts may also be viewed as part of a concept scheme.
    A Concept Scheme is used to denote a codelist.
    In section 10. Controlled Vocabularies, the expectations are elaborated in more detail.
    For this entity the following properties are defined: "title (dct:title)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended Class."@en ;
    rdfs:seeAlso <https://www.w3.org/2009/08/skos-reference/skos.html#ConceptScheme> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#ConceptScheme> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#ConceptScheme> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#controlled-vocabularies> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog
dcat:Catalog 
    rdfs:comment """A concrete mobility data portal, i.e, a web portal, where mobility-related datasets and their distributions are described via metadata and discoverable for data users.
    For this entity the following properties are defined: "dataset (dcat:dataset)", "description (dct:description)", "geographical coverage (dct:spatial)", "has part (dcat:hasPart)", "homepage (foaf:homepage)", "identifier (dct:identifier)", "language (dct:language)", "licence (dct:licence)", "modification date (dct:modified)", "other identifier (adms:identifier)", "publisher (dct:publisher)", "record (dcat:record)", "release date (dct:issued)", "themes (dcat:themeTaxonomy)", "title (dct:title)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class." ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Catalogue> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Catalogue> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record
dcat:CatalogRecord 
    rdfs:comment """A description of a metadata entry in the mobility data portal, referring to one dataset and its distributions published on the portal. 
    mobilityDCAT-AP assumes that metadata records are essential in mobility data portals, so the obligation of this class is raised to "mandatory", comparing to DCAT-AP-v3.0.0.
    For this entity the following properties are defined: "application profile (dct:conformsTo)", "language (dct:language)", "listing date (dct:issued)", "modification date (dct:modified)", "primary topic (foaf:primaryTopic)", "publisher (dct:publisher)", "source metadata (dct:source)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Catalog_Record> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord> ,
                 <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#CatalogueRecord> ,
                 <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset
dcat:Dataset 
    rdfs:comment """A dataset is a collection of data, published or curated by a single source, and available for access or download at the mobility data portal in one or more distributions. In the context of mobility-related data exchange, this might be, e.g., a data collection about static parking information for truck drivers, published by a road authority.
    For this entity the following properties are defined: "applicable legislation (dcatap:applicableLegislation)", "assessment result (mobilitydcatap:assessmentResult)", "contact point (dcat:contactPoint)", "dataset distribution (dcat:distribution)", "description (dct:description)", "documentation (foaf:page)", "frequency (dct:accrualPeriodicity)", "geographical coverage (dct:spatial)", "georeferencing method (mobilitydcatap:georeferencingMethod)", "has version (dcat:hasVersion)", "identifier (dct:identifier)", "in series (dcat:inSeries)", "intended information service (mobilitydcatap:intendedInformationService)", "keyword (dcat:keyword)", "language (dct:language)", "mobility theme (mobilitydcatap:mobilityTheme)", "modification date (dct:modified)", "network coverage (mobilitydcatap:networkCoverage)", "other identifier (adms:identifier)", "publisher (dct:publisher)", "quality description (dqv:hasQualityAnnotation)", "reference system (geodcatap:referenceSystem)", "related resource (dct:relation)", "release date (dct:issued)", "rights holder (dct:rightsHolder)", "source (dct:source)", "temporal coverage (dct:temporal)", "theme (dcat:theme)", "title (dct:title)", "transport mode (mobilitydcatap:transportMode)", "version (dcat:version)", "version notes (adms:versionNotes)". """@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0-draft/#Dataset> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Dataset> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series
dcat:DatasetSeries
    rdfs:comment """A collection of datasets that are published separately, but share some characteristics that group them. 
    It is recommended to avoid Dataset Series without a dataset in the collection. Therefore at least one Dataset should refer to a Dataset Series using the property in series (dcat:inSeries).
    Further instructions on the usage of Dataset Series are given in the mobilityDCAT-AP Wikisection on Dataset Series, the DCAT-AP Usage Guide on Dataset Series, and the DCAT-AP Examples for Dataset Series.
    For this entity the following properties are defined: "applicable legislation (dcatap:applicableLegislation)", "contact point (dcat:contactPoint)", "description (dct:description)", "frequency (dct:accrualPeriodicity)", "geographical coverage (dct:spatial)", "mobility theme (mobilitydcatap:mobilityTheme)", "modification date (dct:modified)", "publisher (dct:publisher)", "release date (dct:issued)", "temporal coverage (dct:temporal)", "title (dct:title)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a XXX class."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Dataset_Series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#DatasetSeries> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#DatasetSeries> ,
                <https://github.com/mobilityDCAT-AP/mobilityDCAT-AP/wiki/Chapter-3:-Extra-explanations-on-specific-Metadata-elements#6-dataset-series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#usage-guide-on-dataset-series> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#example-dataset-series> .

### https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution
dcat:Distribution 
    rdfs:comment """A distribution describes the data formats and communication methods for a dataset. There may be one or multiple distributions for one dataset. For example, the same data set (e.g. static parking information for truck drivers) can be provided in different ways e.g. as downloadable zip file or as XML using a REST web service. These are two distributions based on one dataset. 
    For the context of mobility data portals, it can be expected that all datasets have one or more distributions. Thus, there must be at least one instance of class Distribution related to one dataset. This is in contrast to DCAT-AP v3.0.0, which allows for datasets without distributions.
    For this entity the following properties are defined: "access url (dcat:accessURL)", "application layer protocol (mobilitydcatap:applicationLayerProtocol)", "applicable legislation (dcatap:applicableLegislation)", "character encoding (cnt:characterEncoding)", "communication method (mobilitydcatap:communicationMethod)", "data format notes (mobilitydcatap:dataFormatNotes)", "description (dct:description)", "documentation (foaf:page)", "download url (dcat:downloadURL)", "format (dct:format)", "language (dct:language)", "licence (dct:license)", "linked schemas (dct:conformsTo)", "mobility data standard (mobilitydcatap:mobilityDataStandard)", "modification date (dct:modified)", "release date (dct:issued)", "rights (dct:rights)", "sample (adms:sample)", "status (adms:status)", "temporal coverage (dct:temporal)", "title (dct:title)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Class:Distribution> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Distribution> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Distribution> .


### http://xmlns.com/foaf/spec#term_Agent
foaf:Agent 
    rdfs:comment """An entity (e.g., an individual or an organisation) that is associated with Catalogues, Catalogue Records, or Datasets. 
    If the Agent is an organisation, the use of the Organization Ontology [VOCAB-ORG] is recommended. See §11. Agent Types, Agent Roles and Contact Information for a discussion on Agent types, roles and properties. 
    The agent might be populated with the same information as for a kind, see class "vcard:Kind". See §11. Agent Types, Agent Roles and Contact Information for further usage notes on that matter. 
    When providing agent information, data publishers SHOULD prioritize organizational information over personal details. The exposure of personal information, such as a personal name and email address, may be restricted to the public. Instead, there might be an anonymous contact channel, e.g. a contact button on the GUI that triggers an email to the agent. See §13. Privacy and security considerations. 
    For this entity the following properties are defined: "address (locn:address)", "affiliation (org:memberOf)", "email (foaf:mbox)", "first name (foaf:firstName)", "name (foaf:name)", "phone (foaf:phone)", "surname (foaf:surname)", "type (dct:type)", "URL (foaf:workplaceHomepage)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory class." ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec#term_Agent> ,
                <https://www.w3.org/TR/vocab-org/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#agent-roles> ,
                <https://www.w3.org/TR/vocab-dcat-3/#Class:Organization_Person> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Agent> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Agent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#privsec> .

### http://xmlns.com/foaf/spec/#term_Document
foaf:Document 
    rdfs:comment """A textual resource intended for human consumption that contains information, e.g. a web page about a Dataset.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec/#term_Document> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Document> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Document> .

### https://www.w3.org/TR/vcard-rdf/#d4e1588
vcard:Email
    rdfs:comment """The electronic mail address for communication with the object.
    See Email in the VCard Ontology.
    This class is analogue to an addition by geoDCAT-AP v3.0.0.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1588> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Email(vCard)> ,
                <https://www.w3.org/2006/vcard/ns#Email> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Frequency
dct:Frequency
    rdfs:comment """A rate at which something recurs, e.g., the update rate of a dataset.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#Frequency> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Frequency> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Frequency> .

### http://data.europa.eu/eli/ontology#LegalResource
eli:LegalResource
    rdfs:comment """The legislation, policy or policies that lie behind the rules that govern the service.
    The definition and properties of the Legal Resource class are aligned with the ontology included in "Council conclusions inviting the introduction of the European Legislation Identifier (ELI)". For describing the attributes of a Legal Resource (labels, preferred labels, alternative labels, definition, etc.) we refer to the ELI ontology. In this data specification the use is restricted to instances of this class that follow the ELI URI guidelines.
    This specification does not impose any additional requirements to properties for this entity,"""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <http://data.europa.eu/eli/ontology#LegalResource> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#LegalResource> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#LegalResource> ,
                <https://eur-lex.europa.eu/eli-register/about.html> ,
                <https://op.europa.eu/en/web/eu-vocabularies/eli> .

### https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry
locn:Geometry
    rdfs:comment """The means to identify a location as a point, line, polygon, etc. expressed using coordinates in some coordinate reference system.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://semiceu.github.io/Core-Location-Vocabulary/releases/2.1.0/#Geometry> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Geometry> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Geometry> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LinguisticSystem
dct:LinguisticSystem
    rdfs:comment """A system of signs, symbols, sounds, gestures, or rules used in communication, e.g. a language.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#LinguisticSystem> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Linguisticsystem> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Linguisticsystemt> .

### https://www.w3.org/TR/rdf11-schema/#ch_literal
rdfs:Literal
    rdfs:comment """A literal value such as a string or integer; Literals may be typed, e.g. as a date according to xsd:date. Literals that contain human-readable text have an optional language tag as defined by BCP 47 rfc5646.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-schema/#ch_literal> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Literal> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Literal> ,
                <https://datatracker.ietf.org/doc/html/rfc5646> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#MediaTypeOrExtent
dct:MediaTypeOrExtent
    rdfs:comment """A media type or extent.
    In mobilityDCAT-AP, this class is only used as the range of property dct:format for class Distribution.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#MediaTypeOrExtent> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1-draft/#MediaTypeorExtent> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#MediaTypeorExtent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#distribution-format> .

### https://www.w3.org/ns/org#Organization
org:Organization
    rdfs:comment """Represents a collection of people organized together into a community or other social, commercial or political structure. The group has some common purpose or reason for existence which goes beyond the set of people belonging to it and can act as an Agent. Organizations are often decomposable into hierarchical structures.
    See Organization in The Organization Ontology.
    This class is analogue to an addition by geoDCAT-AP v3.0.0.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.w3.org/ns/org#Organization> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Organisation> ,
                <https://www.w3.org/TR/vocab-org/#org:Organization> .

### https://www.w3.org/TR/rdf11-schema/#ch_resource
rdfs:Resource
    rdfs:comment """Anything described by RDF.
    This specification does not impose any additional requirements to properties for this entity."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class." ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf11-schema/#ch_resource> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Resource> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Resource> .

#################################################################
#    Properties
#################################################################

###  http://www.w3.org/ns/locn#address
locn:address a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The postal address of the agent. 
    This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "address"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes locn:Address ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#address> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://www.w3.org/ns/org#memberOf
org:memberOf a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The affiliation of the agent. This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "affiliation"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes org:Organization ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-org/#org:memberOf> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
		   
###  http://xmlns.com/foaf/0.1/mbox
foaf:mbox a rdf:Property,
	owl:ObjectProperty ;
    rdfs:comment """The email address of the agent, specified using fully qualified mailto: URI scheme RFC6068. This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "email"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/mbox> ,
                <https://www.rfc-editor.org/rfc/rfc6068> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://xmlns.com/foaf/0.1/phone
foaf:phone a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The phone number of the agent, specified using fully qualified tel: URI scheme RFC3966. This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "phone"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/phone> ,
                <https://www.rfc-editor.org/rfc/rfc3966> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .
		   
###  http://xmlns.com/foaf/0.1/workplaceHomepage
foaf:workplaceHomepage a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """The Web site of the agent.
    This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    rdfs:label "URL"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/#term_workplaceHomepage> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .

###   https://www.w3.org/TR/annotation-vocab/#hasbody
oa:hasBody a rdf:Property ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:comment """For Assessments, this property indicates the result of the latest assessment procedure, in form of a URL linking to further details or results. Alternatively, textual information is provided using the Embedded Textual Body construction of the Web Annotation Data Model, which allows to specify text formats and languages which might be relevant for multilingual purposes.

    For Quality Annotations, this property contains any quality aspects regarding the delivered content, in form of a URL linking to further details or results, or textual information.
    Textual information should be provided using the Embedded Textual Body construction of the Web Annotation Data Model, which allows to specify text formats and languages which might be relevant for multilingual purposes."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Assessments and Quality Annotations. "@en ;
    dcam:domainIncludes mobilitydcatap:Assessment ,
                        dqv:QualityAnnotation ;
    dcam:rangeIncludes rdfs:Resource ,
                       rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/annotation-vocab/#hasbody> ,
                <https://www.w3.org/TR/annotation-model/> .


###   http://www.w3.org/ns/adms#identifier
adms:identifier a rdf:Property,
    owl:ObjectProperty ;
    rdfs:label "other identifier"@en ;
    rdfs:comment """For Catalogue, this property may be used as an additional identifier, besides dct:identifier.
    This property may be referring to a dedicated, EU-wide identificator system of NAPs or other portals, to be introduced in the future.
    This property is an addition by mobilityDCAT-AP.

    For Dataset, This property may be used as an additional identifier, besides dct:identifier.This property may be referring to a dedicated, EU-wide identificator system of NAP datasets, to be introduced in the future, or other identificator systems such as DataCite, DOI, or W3ID."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogues and Datasets. "@en ;           
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:Dataset ;
    dcam:rangeIncludes adms:Identifier ;
    rdfs:seeAlso <http://www.w3.org/ns/adms#identifier> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#catalogue-identifier> ,
                <https://schema.datacite.org/> ,
                <http://www.doi.org/> ,
                <https://w3id.org/> .
           			   			   
		   
### http://purl.org/dc/terms/publisher
dct:publisher a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Catalogue, this property refers an entity (an organisation or a person), which is responsible for creation and maintenance of the metadata entry on the data platform. This entity is the direct contact for the data platform operators or data-searching users, who have questions or issues about the metadata entry.
    This information can be natively created by a data platform, corresponding to the entity that is registered to the data platform and has the role of a metadata creator. This information can be also harvested from other portals. The information might be identical to the property dct:publisher of the corresponding dataset.
    This property is analogue to an addition by GEODCAT-AP-v3.0.0.

    For Catalogue Record, this property refers to an entity (an organisation or a person), which is responsible for creation and maintenance of the metadata entry on the data platform. This entity is the direct contact for the data platform operators or data-searching users, who have questions or issues about the metadata entry. This information can be natively created by a data platform, then corresponding to the entity that is registered to the data platform and has the role of a metadata creator. This information can be also harvested from other portals. It should include, as a minimum, the name and email address of the entity. The information might be identical to the property "Publisher" of the corresponding dataset. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]. 

    For Dataset, this property refers to an entity (company and person) that publishes the dataset. This entity is responsible for the provisioning of a dataset. The entity also concludes a contract, if applicable.
    This information can be natively created by a data platform, then corresponding to the entity that is registered to the data platform and has the role of a data publisher. The information might be identical to the property dct:publisher of class Catalogue Record and/or dct:rightsHolder of class Dataset.
    To establish a contact with a company or person responsible for the dataset, the property dcat:contactPoint should be used.
    However, the publisher and the contact point might be populated with the same information. See 11. Agent Types, Agent Roles and Contact Information for further usage notes on that matter.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0.

    For Dataset Series, it refers to an entity (company and person) that publishes the dataset series. This entity is also responsible for ensuring the coherency of the dataset series.
    The publisher of the dataset series may or may be not the publisher of all datasets, as declared via property dct:publisher. E.g. a digital archive could take over the publishing of older datasets in the series.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0."""@en ;
    rdfs:label "publisher"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues and Datasets, and it is an optional property to be used for Catalogue Records."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:CatalogRecord ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ;
    dcam:rangeIncludes foaf:Agent ;
    rdfs:seeAlso <http://purl.org/dc/terms/publisher> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-publisher> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#catalogue-record-publisher> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-rights-holder> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-contact-point> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#agent-roles> .


###  http://purl.org/dc/terms/source
dct:source a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property is used for metadata records that are harvested from other portals. Harvesting, i.e., the automated import of metadata information from external portals, seems to be a common case for some NAPs. With these property, a data user can see, if the metadata was harvested, and from where. The property SHOULD link to a public URL of the dataset descripton on the original data portal, from where the metadata was harvested."""@en ;
    rdfs:label "source metadata"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogue Records."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:CatalogRecord ;
    dcam:rangeIncludes dcat:CatalogRecord ;
    rdfs:seeAlso <http://purl.org/dc/terms/source> .	

###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Category, this property MAY be used to specify the Category Scheme to which the Category belongs. This property is analogue to an addition by [GEODCAT-AP-v2.0.0].
    For Location, this property MAY be used to specify the gazetteer to which the Location belongs. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Categories, and it is a recommended property to be used for Locations."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes skos:Concept ,
                        dct:Location ;
    dcam:rangeIncludes skos:ConceptScheme ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core#inScheme> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .     
		   
###  https://w3id.org/mobilitydcat-ap#mobilityTheme
mobilitydcatap:mobilityTheme a rdf:Property,
    owl:ObjectProperty ;
	rdfs:subPropertyOf dcat:theme ;
    rdfs:comment """This property refers to the mobility-related theme (i.e., a specific subject, category, or type) of the delivered content. A dataset may be associated with multiple themes. A theme is important for data seekers who are interested in a particular type of data content. The theme is described via a controlled vocabulary in two hierarchy levels: The 1st level is a mandatory field labelled "Data content category", describing the classification of the data content on an aggregated level. The 2nd level is an optional field labelled "Data content sub category", detailing the "Data content category" via one or several sub-categories. When entering the metadata for one dataset, the data provider would first select one or several options of a "Data content category", and then optionally details this with one or more options of corresponding "Data content sub category". The platform must be able to handle the dependencies between these two levels, i.e., match the allowed options between the 1st and 2nd level. A corresponding controlled vocabulary is provided. This property is a sub-property of dcat:theme, which is also a further, recommended property of Dataset. To distinguish the both theme properties, it is recommended to label mobilitydcatap:mobilityTheme as "Mobility Theme", and dcat:theme as "EU Open Data Theme". The subject of a dataset MAY also be described via a property dcat:keyword. However, the usage of "theme / category" is preferred, to avoid ambiguity and uncontrolled theme descriptions."""@en ;
    rdfs:label "mobility theme"@en  ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for  Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-mobility-theme> . 

###  https://w3id.org/mobilitydcat-ap#georeferencingMethod
mobilitydcatap:georeferencingMethod a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property SHOULD be used to specify the georeferencing method used in the dataset. A controlled vocabulary is provided, denoting commonly used georeferencing methods for mobility data."""@en ;
    rdfs:label "georeferencing method"@en  ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-georeferencing-method> . 

		   
###  http://purl.org/dc/terms/conformsTo
dct:conformsTo a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """In the context of Datasets, this property SHOULD be used to specify the spatial reference system used in the dataset. Spatial reference systems SHOULD be specified by using the corresponding URIs from the "EPSG coordinate reference systems" register operated by OGC [OGC-EPSG]. A controlled vocabulary is provided. This property is analogue to an addition by [GEODCAT-AP-v2.0.0].
    In the context of Mobility Data Standard, this property describes the name of the mobility data standard. This property is necessary for the following CASE 1: A custom instance of mobilitydcatap:MobilityDataStandard is defined. Such custom instance is recommended when the mobility data standard is detailed out via properties owl:versionInfo and/or mobilitydcatap:schema. The property dct:conformsTo would then name the mobility data standard via a controlled vocabulary. In the alternative CASE 2, the name the mobility data standard is directly named as range of mobilitydcatap:MobilityDataStandard, again via the same controlled vocabulary."""@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets, and an optional property to be used for Mobility Data Standards. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ,
                        mobilitydcatap:MobilityDataStandard ;
    dcam:rangeIncludes dct:Standard ,
                       skos:Concept ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#conformsTo> ,
                <http://www.opengis.net/def/crs/EPSG/> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-conforms-to> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-mobility-data-standard> .

###  http://purl.org/dc/terms/rightsHolder
dct:rightsHolder a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property refers to an entity that legally owns or holds the rights of the data provided in a dataset. This entity is legally responsible for the content of the data. It is also responsible for any statements about the data quality (if applicable, see property dqv:hasQualityAnnotation) and/or the relevance to legal frameworks (if applicable, see property dcatap:applicableLegislation). This entity is the direct contact for the platform operator or data consumers, who have questions or issues about the contents of a dataset. The Rights Holder will be in many cases identical with the Publisher information for class Dataset (see property dct:publisher) and/or for class Catalogue Record (see property dct:publisher). In this case, the contact data MAY be copied from the corresponding Publisher entries. There might be also cases with non-identical entities: e.g., when one or several Rights Holders contract a third-party Publisher (e.g., an IT service company), which is producing, hosting and publishing a dataset. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "rights holder"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes foaf:Agent ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#rightsHolder> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> . 

###  https://w3id.org/mobilitydcat-ap#networkCoverage
mobilitydcatap:networkCoverage a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property describes the part of the transport network that is covered by the delivered content. For road traffic, the property SHOULD refer to the network classification for which the data is provided. As a minimum, an international or higher-level classification, e.g., via functional road classes, is recommended to allow data search across different countries. In addition, national classifications are allowed. For other transport modes, the property is meant to refer to the physical infrastructure which is used by the services covered by the data. For all modes, the property SHOULD also indicate if the data content relates to the EU’s trans-European transport network [EU-TEN-T]. A controlled vocabulary is provided, denoting commonly used road and infrastructure network classes."""@en ;
    rdfs:label "network coverage"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://transport.ec.europa.eu/transport-themes/infrastructure-and-investment/trans-european-transport-network-ten-t_en> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-network-coverage> .

		   
###  https://w3id.org/mobilitydcat-ap#transportMode
mobilitydcatap:transportMode a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property describes the transport mode that is covered by the delivered content. Data can be valid for more than one mode, so a multiple choice should be applied. A controlled vocabulary is provided, denoting commonly used transport modes."""@en ;
    rdfs:label "transport mode"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-transport-mode> .
		   
###  http://data.europa.eu/r5r/applicableLegislation
dcatap:applicableLegislation a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY refer to one or several legal frameworks being relevant for the dataset, e.g., an EC Delegated Regulation which constitutes the purpose of the corresponding data platform (here called National Access Point/NAP), or some other international or national frameworks, e.g., Open Data regulations. For European legal frameworks, it is recommended to use the European Legislation Identifier [ELI] to refer to legislation whenever possible. This property is derived from the DCAT-AP HVD extension [DCAT-AP-HVD]."""@en ;
    rdfs:label "applicable legislation"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://semiceu.github.io/DCAT-AP/r5r/releases/3.0.0/#applicableLegislation> ,
                <https://eur-lex.europa.eu/eli-register/eu_publications_office.html> ,
                <https://semiceu.github.io/DCAT-AP/releases/2.2.0-hvd/> .

###  https://w3id.org/mobilitydcat-ap#assessmentResult
mobilitydcatap:assessmentResult a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY refer to the results and outcomes from an assessment process by some organisation, e.g., a National Body in the context of EU Delegated Regulations. EU Delegated Regulations require Member States to set up procedures to assess the compliance of the Delegated Regulations, e.g. regarding the provisioning of data via a NAP. These assessment processes are handled by National Bodies [NAPCORE-NB] and installed individually in each Member State. The property MAY point to the most recent assessment procedure, including its date, its result as a free-text and/or a link referring to an assessment report online. The difference to the property dqv:hasQualityAnnotation is that the latter one is provided by the data provider, while the assessment results are provided by an external organisation."""@en ;
    rdfs:label "assessment result"@en  ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes mobilitydcatap:Assessment ;
    rdfs:seeAlso <https://napcore.eu/national-bodies/> .
		   
###  https://w3id.org/mobilitydcat-ap#intendedInformationService
mobilitydcatap:intendedInformationService a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY describe predefined information services, which the data content is intended to support. Such services MAY be, e.g., information services for multimodal mobility, as specified by EC Delegated Regulation 2017/1926 [EC-MMTIS-DR]. Examples of such services include "location search", which is based on a datasets with address identifiers, or "trip plan computation", which is based on datasets about a road network. A controlled vocabulary is provided."""@en ;
    rdfs:label "intended information service"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;		
    rdfs:seeAlso <https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=CELEX%3A32017R1926> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-information-service> .
		      
		   
###  http://www.w3.org/ns/dqv#hasQualityAnnotation
dqv:hasQualityAnnotation a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY describe any quality aspects regarding the delivered content, in particular methods, metrics/indicators and results of a quality assessment in the responsibility of the Rights Holder (see property dct:rightsHolder). This information SHOULD assist data consumers in determining the value of data, before actually accessing and processing it. Thus, the information SHOULD be publicly available. Furthermore, it can be helpful for validation processes by 3rd parties, e.g., a National Body in context of EU Delegated Regulations. Quality aspects SHOULD be noted via a free text and/or via URLs linking to further quality information. If there is absolutely no quality information, at least a note "quality information is unknown" SHOULD be given. If existing quality frameworks have been applied in the quality assessment, e.g., the Quality Packages from the EU EIP and NAPCORE projects [EU-EIP-QP], these frameworks should be referenced. """@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dqv:QualityAnnotation ;
    rdfs:seeAlso <https://www.its-platform.eu/achievement/quality-of-european-its-services-and-their-data/> ,
                <https://www.w3.org/TR/vocab-dqv/#dqv:hasQualityAnnotation> .


###  https://w3id.org/mobilitydcat-ap#mobilityDataStandard
mobilitydcatap:mobilityDataStandard a rdf:Property,
    owl:ObjectProperty ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment """This property describes the mobility data standard, as applied for the delivered content within the Distribution. A mobility data standard, e.g., DATEX II, combines syntax and semantic definitions of entities in a certain domain (e.g., for DATEX II: road traffic information), and optionally adds technical rules for data exchange. A controlled vocabulary is provided, listing common mobility data standards. If no established mobility data standard is applied, an information "proprietary standard" is requested."""@en ;
    rdfs:label "mobility data standard"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes mobilitydcatap:MobilityDataStandard ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-mobility-data-standard> .

		   
###  https://w3id.org/mobilitydcat-ap#applicationLayerProtocol
mobilitydcatap:applicationLayerProtocol a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property describes the transmitting channel, i.e., the Application Layer Protocol, of the distribution. A controlled vocabulary is provided. """@en ;
    rdfs:label "application layer protocol"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this property is recommended to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-application-layer-protocol> .
		   
###  https://w3id.org/mobilitydcat-ap#communicationMethod
mobilitydcatap:communicationMethod a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property indicates for data services, e.g., data feeds, if the data interface of the data provider system functions in a push or pull mode. A controlled vocabulary is provided."""@en ;
    rdfs:label "communication method"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-communication-method> .
   
		   
###  https://w3id.org/mobilitydcat-ap#grammar
mobilitydcatap:grammar a rdf:Property,
    owl:ObjectProperty ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment """This property describes the technical data grammar format of the delivered content within the Distribution. It describes the standard on top of the elementary syntax that describe data structures in the dataset. A controlled vocabulary is provided. This is a sub-property of dct:conformsTo."""@en ;
    rdfs:label "grammar"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-grammar> .


###  http://www.w3.org/ns/adms#sample
adms:sample a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property refers to a sample Distribution of the Dataset. A data sample allows data users to investigate the data content and data structure, without subscribing to a data feed or downloading a complete data set. In [DCAT-AP-v2.0.1], there is a property adms:sample under the class dcat:Dataset , with a range of dcat:Distribution. This implies, that all mandatory properties from dcat:Distribution, e.g., mobilitydcatap:mobilityDataStandard, must be applied. To simplify the description of the Sample, mobilityDCAT-AP recommends to describe the Sample via a property under class dcat:Distribution. It is assumed that all other properties, as already populated for dcat:Distribution, e.g., mobilitydcatap:mobilityDataStandard, also apply for the description of the data sample."""@en ;
    rdfs:label "sample"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-adms/#adms-sample> ,
                <https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/201-0> .

###  http://purl.org/dc/terms/temporal
dct:temporal a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """For Dataset, this property refers to a temporal period, i.e., the beginning and the end, of the time reference of the delivered content (e.g., validity time of a public-transport time table).
    For Distribution, this property describes the beginning and end of the time interval when a data service, e.g., a data feed, is delivered technically via the data platform. If there is no entry it means that the publication gets valid immediately and the timestamp is the same as the metadata timestamp."""@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets, and it is an optional property to be used for Distributions. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ,
                        dcat:Dataset ;
    dcam:rangeIncludes dct:PeriodOfTime ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#temporal> .

		   
###  http://www.w3.org/2006/vcard/ns#hasEmail
vcard:hasEmail a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property contains an email address of the Kind, specified using fully qualified mailto: URI scheme [RFC6068]. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "email"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes owl:Thing ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e183> ,
                <https://www.rfc-editor.org/rfc/rfc6068> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .

###  http://www.w3.org/2006/vcard/ns#hasURL
vcard:hasURL a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property points to a Web site of the Kind. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "URL"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes owl:Thing ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e876> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .
	
###  http://www.w3.org/2006/vcard/ns#hasAddress
vcard:hasAddress a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY be used to specify the postal address of the Kind. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "address"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes vcard:Address ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e876> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .

###  http://www.w3.org/2006/vcard/ns#hasTelephone
vcard:hasTelephone a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY be used to provide the phone number of the Kind, specified using fully qualified tel: URI scheme [RFC3966]. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "phone"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes owl:Thing ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e876> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .
           

###  https://w3id.org/mobilitydcat-ap#schema
mobilitydcatap:schema a rdf:Property,
    owl:ObjectProperty ;
    rdfs:subPropertyOf dct:conformsTo ;
    rdfs:comment """This property describes the schema of the mobility data standard, as applied within the delivered content. There are differet optiions how to reference the schema. It might be a reference to a portal-internal catalogue of schemas, a reference to an individual schema (that is provided by the data publisher), or a reference to an external catalogue of schemas (like a stakeholder-based DATEX II profile published on the datex2.eu page). The data platform SHOULD keep an archive of commonly used schemas. The data provider SHOULD be able to select an applicable schema from this archive, or to upload an own, individual schema. In any case, the schema should be available as a resource. This is a sub-property of dct:conformsTo."""@en ;
    rdfs:label "schema"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Mobility Data Standards."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes mobilitydcatap:MobilityDataStandard ;
    dcam:rangeIncludes rdfs:Resource .
	
###   http://www.w3.org/ns/oa#hasTarget
oa:hasTarget a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property MAY be used to describe the target of the quality annotation, referring back to the dataset being described. I.e., it is the inverse property of "dqv:hasQualityAnnotation" for class Dataset."""@en ;
    rdfs:label "quality annotation target"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Quality Annotations. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dqv:QualityAnnotation ;
    dcam:rangeIncludes dcat:Dataset ;
    rdfs:seeAlso <https://www.w3.org/TR/annotation-vocab/#hastarget> . 		

###   http://www.w3.org/ns/oa#hasTarget
dcat:distribution a rdf:Property,
    owl:ObjectProperty ;
    rdfs:comment """This property links the dataset to an available distribution. 
    In mobilityDCAT-AP, it is mandatory that each dataset has at least one distribution. Thus, the obligation of this property is raised to "mandatory", compared to [DCAT-AP-v2.0.1]."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Datasets. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dcat:Distribution ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-2/#Property:dataset_distribution> ,
                <https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/201-0> .
		   
###  http://www.w3.org/ns/locn#adminUnitL2
locn:adminUnitL2 rdf:type owl:DatatypeProperty ;
    rdfs:comment """The administrative area of an Address of the Agent. Depending on the country, this corresponds to a province, a county, a region, or a state."""@en ;
    rdfs:label "administrative area"@en  ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Addresses (Agent)"@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#adminUnitL2> .
		   
###  http://www.w3.org/ns/locn#postName
locn:postName rdf:type owl:DatatypeProperty ;
    rdfs:comment "The city of an Address of the Agent."@en ;
    rdfs:label "city"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Addresses (Agent)"@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#postName> .
		   
###  http://www.w3.org/ns/locn#adminUnitL1
locn:adminUnitL1 rdf:type owl:DatatypeProperty ;
    rdfs:comment "The country of an Address of the Agent."@en ;
    rdfs:label "country"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Addresses (Agent)"@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#adminUnitL1> .

###  http://www.w3.org/ns/locn#postCode
locn:postCode rdf:type owl:DatatypeProperty ;
    rdfs:comment "The postal code of an Address of the Agent."@en ;
    rdfs:label "postal code" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Addresses (Agent)"@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#postCode> .
		   
###  http://www.w3.org/ns/locn#thoroughfare
locn:thoroughfare rdf:type owl:DatatypeProperty ;
    rdfs:comment "The street name and civic number of an Address of the Agent."@en ;
    rdfs:label "street address"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Addresses (Agent)"@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/ns/locn#thoroughfare> .


###  http://xmlns.com/foaf/0.1/name
foaf:name 
    rdfs:comment """A name of the agent. This property can be repeated for different versions of the name (e.g. the name in different languages) - see 12. Accessibility and Multilingual Aspects."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Agents."@en ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://xmlns.com/foaf/0.1/name> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#accessibility-and-multilingual-aspects> .


### http://purl.org/dc/terms/type
dct:type 
    rdfs:comment """For Agents, refers to the nature of the agent.
    A controlled vocabulary is provided.

    For Rights Statements, it refers to the conditions for access and usage. An indication of the conditions if any contracts, licences and/or are applied for the use of the distribution. The conditions are declared on an aggregated level: whether a free and unrestricted use is possible, a contract has to be concluded and/or a licence has to be agreed on to use a dataset.
    A controlled vocabulary is provided.
    The values can be logically mapped with the property dct:identifier from class Licence Document, denoting a concrete standard license. For example, if the property dct:identifier is referring to standard licence "CC BY 4.0", the property dct:type can be given the value "Licence provided, free of charge"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Agents, and it is a mandatory property to be used for Rights Statements."@en ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dct:RightsStatement ,
                        foaf:Agent ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <http://purl.org/dc/terms/type> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-publisher-type> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-conditions-for-access-and-usage> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#licence-document-standard-licence> .
 
	   
###   http://purl.org/dc/terms/issued
dct:issued rdf:type owl:DatatypeProperty ;
    rdfs:comment """In mobilityDCAT-AP, this property corresponds to the notion of "temporal reference - publication date - assessment date".

    For Catalogue, this property indicates the date of formal issuance (e.g., publication) of the mobility data portal.

    For Catalogue Record, this property indicates the date on which the metadata entry was included in the Catalogue.
    It should be generated by the system, whenever a platform user enters the metadata entry.

    For Assessment, this property describes the date of the latest assessment procedure.

    For Dataset, this property contains the date of formal issuance (e.g., publication) of the dataset. 
    There might be a difference to the creation date of the metadata entry, see the property dct:created of Class Catalogue Record. Imagine the dataset is published outside the mobility data portal first, and afterwards published as a metadata entry on the portal, leading to two different dates. However, both dates can also be the same.

    For Dataset Series, this property indicates the date of formal issuance (e.g., publication) of the dataset series. 
    The moment when the dataset series was established as a managed resource. This might correspond to the earliest release date of the dataset in the collection, as declared via property dct:issued. See also the examples no. 9 and 10 in the Dataset Series examples section of DCAT-AP v3.0.0.

    For Distribution, this property contains the date of formal issuance (e.g., publication) of the Distribution. 
    There is the same property dct:issued at the Dataset level. Under the distribution level, this property relates to the release time of a distribution, which might be different than the release time of a dataset."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Assessments and Datasets; and it is a recommended property to be used for Catalogues. Its range is rdfs:Literal typed as xsd:date or xsd:dateTime. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes mobilitydcatap:Assessment ,
                        dcat:Catalog ,
                        dcat:CatalogRecord ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ,
                        dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://purl.org/dc/terms/issued> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#catalogue-record-creation-date> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#example-dataset-series> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-release-date> .

###  http://xmlns.com/foaf/spec/#term_firstName
foaf:firstName rdf:type owl:DatatypeProperty ;
    rdfs:comment """The first name of the agent. To be used if the agent is of type person, see 11. Agent Types, Agent Roles and Contact Information."""@en ;
    rdfs:label "first name"@en  ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec/#term_firstName> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#agent-roles> .

		   
### http://xmlns.com/foaf/spec/#term_surname
foaf:surname rdf:type owl:DatatypeProperty ;
    rdfs:comment """The surname of the agent. To be used if the agent is of type person, see 11. Agent Types, Agent Roles and Contact Information."""@en ;
    rdfs:label "surname"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Agents."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes locn:Address ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://xmlns.com/foaf/spec/#term_surname> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#agent-roles> .

		   
###   http://purl.org/dc/terms/identifier
dct:identifier a rdf:Property ;
    vs:term_status "stable" ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    rdfs:comment """For Catalogues, it is the main identifier for the mobility data portal, e.g. the URI or other unique identifier. Allows a unique identification of the individual portal and is used for referencing, e.g., when exchanging metadata between mobility data portals.
    This property should populated by the URI used within the RDF statement (via rdf:about).
    This property is analogue to an addition by geoDCAT-AP v3.0.0.

    For Location, this property contains the geographic identifier for the location, e.g., the URI or other unique identifier in the context of the relevant gazetteer.
    Corresponding controlled vocabularies are provided, denoting commonly used geographic identifiers.
    This property is analogue to an addition by geoDCAT-AP v3.0.0.

    For Dataset, it is the main identifier for the dataset, e.g. the URI or other unique identifier. Allows a unique identification of the individual dataset and is used for referencing, e.g., when exchanging metadata between mobility data portals.
    This property should populated by the URI used within the RDF statement (via rdf:about)."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogues and Datasets, and it is a recommended property to be used for Licence Documents, and Locations. "@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dct:Location ,
                        dcat:Dataset ,
                        dct:LicenseDocument ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://purl.org/dc/terms/identifier> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-spatial> .

 	   
###   http://purl.org/dc/terms/created
dct:created rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property contains the date stamp (date and time) when the metadata entry was created for the first time. It SHOULD be generated by the system, whenever a platform user enters the metadata entry. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "creation date"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogue Records. Its range is rdfs:Literal typed as xsd:date or xsd:dateTime. "@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:CatalogRecord ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#created> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .	   
		   
###  https://w3id.org/mobilitydcat-ap#dataFormatNotes
mobilitydcatap:dataFormatNotes rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property contains any additional information about the format of the delivered content within the Distribution (see the corresponding properties dct:format, mobilitydcatap:mobilityDataStandard, mobilitydcatap:grammar), in a textual format. This might be about, e.g., extensions being used in a mobilitydcatap:mobilityDataStandard."""@en ;
    rdfs:label "data format notes"@en ;
    rdfs:isDefinedBy mobilitydcatap:;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal .		   
		   
###  http://www.w3.org/2011/content#characterEncoding
cnt:characterEncoding rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property describes the technical encoding format of the delivered content within the Distribution. It SHOULD be expressed using a character set name defined in the IANA register [IANA-CHARSETS]. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]. This is a sub-property of dct:conformsTo."""@en ;
    rdfs:label "character encoding"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.iana.org/assignments/character-sets> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .	 
		  
###  http://www.w3.org/2006/vcard/ns#fn
vcard:fn rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property contains a name of the Kind. This property can be repeated for different versions of the name (e.g., the name in different languages) - see § 8. Accessibility and Multilingual Aspects. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "name"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e876> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#accessibility-and-multilingual-aspects> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .	   
		   
###  http://www.w3.org/2006/vcard/ns#organization-name
vcard:organization-name rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property MAY be used to specify the affiliation of the Kind. This property can be repeated for different versions of the name (e.g. the name in different languages) - see § 8. Accessibility and Multilingual Aspects. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    rdfs:label "affiliation"@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Kinds."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes vcard:Kind ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e876> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#accessibility-and-multilingual-aspects> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .			   
		   
###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:DatatypeProperty ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    vs:term_status "stable" ;
    rdfs:comment """For Licence Documents, this property MAY be used to contain the full text of a Licence Document, as a free text. This MAY be used when there is no standard license that can be linked via property dct:identifier. This property can be repeated for parallel language versions of the name - see § 8. Accessibility and Multilingual Aspects. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Licence Documents, and it is a recommended property to be used for Rights Statements."@en ;
    dcam:domainIncludes dct:LicenseDocument ,
                        dct:RightsStatement ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/rdf-schema/#ch_label> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#accessibility-and-multilingual-aspects> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .	

###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:DatatypeProperty ;
    rdfs:comment """This property contains a preferred label of the Category. This property can be repeated for parallel language versions of the label - see § 8. Accessibility and Multilingual Aspects."@en ;
    For Locations, this property contains a preferred label of the Location. This property can be repeated for parallel language versions of the label - see § 8. Accessibility and Multilingual Aspects. This property is analogue to an addition by [GEODCAT-AP-v2.0.0]."""@en ;
    vs:term_status "stable" ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Locations, and a mandatory property to be used for Categories."@en ;
    adms:status <http://publications.europa.eu/resource/dataset/concept-status/CURRENT> ;
    dcam:domainIncludes dct:Location ,
                        skos:Concept ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/2012/09/odrl/semantic/draft/doco/skos_prefLabel.html> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#accessibility-and-multilingual-aspects> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/> .		   

### http://purl.org/dc/terms/accessRights
dct:accessRights 
    rdfs:comment """This property MAY include information regarding access or restrictions based on privacy, security, or other policies. For INSPIRE metadata, this property SHOULD be used with the URIs of the ''Limitations on public access'' code list operated by the INSPIRE Registry [INSPIRE-LPA]."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Data Services."@en ;
    dcam:domainIncludes dcat:DataService ;
    dcam:rangeIncludes dct:RightsStatement ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-2/#Property:resource_access_rights> ,
                <http://inspire.ec.europa.eu/metadata-codelist/LimitationsOnPublicAccess> .

### http://purl.org/dc/terms/accrualPeriodicity
dct:accrualPeriodicity 
    rdfs:comment """This property describes how often the delivered content is updated. This information tells a data consumer, how often it is updated on the on the data platform, so the data consumer might align the frequency of data retrieval accordingly. For data services, e.g., data feeds, the frequency should correspond to the technical upload / data push frequency. For static datasets, it should correspond to the expected change frequency (see property dct:modified). The frequency might be a specific time interval, or a general remark such as "updated on occurrence". A controlled vocabulary is provided. The obligation of this property is raised to "mandatory", compared to [DCAT-AP-v2.0.1]."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dct:Frequency ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#accrualPeriodicity> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-update-frequency> ,
                <https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/201-0> .

### http://purl.org/dc/terms/description
dct:description 
    rdfs:comment """For Catalogue, this property contains a free-text account of the Catalogue.
    This property can be repeated for parallel language versions of the description - see 12. Accessibility and Multilingual Aspects.

    For Dataset, this property contains information about the dataset as a free-text description. It is used only for a brief overview, because free-text fields are unsuitable for searches, due to spelling mistakes, different wordings and other aspects. The categorisation and other aspects about the dataset are described within other properties of the dataset.
    This property can be repeated for parallel language versions of the description - see 12. Accessibility and Multilingual Aspects. The language version should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the description.

    For Dataset Series, this property contains information about the dataset series as a free-text description.
    It is recommended to provide an indication about the dimensions the Dataset Series evolves, e.g., if the dataset seriesevolves according to the time, geolocation or other dimensions.
    This property can be repeated for parallel language versions of the description - see 12. Accessibility and Multilingual Aspects. The language version should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the description.

    For Distribution, this property contains a free-text account of the Distribution. This property can be repeated for parallel language versions of the description - see 12. Accessibility and Multilingual Aspects.

    For Rights Statements, this property contains the text of the Rights Statement. I.e., any textual information about access, usage or licensing conditions, beyond information given via other properties under classes dct:RightsStatement and dct:LicenseDocument.
    This property can be repeated for parallel language versions of the information - see 12. Accessibility and Multilingual Aspects.
    This property is analogue to an addition by geoDCAT-AP v3.0.0."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues and Datasets, it is a recommended property to be used for Distributions, and it is an optional property to be used for Data Services."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:DatasetSeries ,
                        dcat:Dataset ,
                        dcat:Distribution ,
                        dct:RightsStatement ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://purl.org/dc/terms/description> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#accessibility-and-multilingual-aspects> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/catalogue-record-language> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .

### http://purl.org/dc/terms/format 
dct:format 
    rdfs:comment """This property refers to the technical syntax of the delivered content within the Distribution. It describes the base standard that specifies syntactically correct documents. On this level, only base elements of building documents properly are specified and can be proved by syntax checks. A controlled vocabulary is provided. The obligation of this property is raised to "mandatory", compared to [DCAT-AP-v2.0.1]. There is a similar property in [DCAT-AP-v2.0.1] dcat:mediaType, which is removed in mobilityDCAT-AP. The reason is the use of Controlled vocabularies: dct:format uses the EU Authority List [EUV-FT], whereas dcat:mediaType uses the IANA media types [IANA-MEDIA-TYPES]. The first one, however, is sufficient to describe the syntaxes commonly used in mobility data portals."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Distributions. "@en ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#format> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#vocab-format> ,
                <https://joinup.ec.europa.eu/collection/semantic-interoperability-community-semic/solution/dcat-application-profile-data-portals-europe/release/201-0> ,
                <https://publications.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/file-type> ,
                <https://www.iana.org/assignments/media-types/> .
   
### http://purl.org/dc/terms/hasPart
dct:hasPart 
    rdfs:comment """This property refers to a related Catalogue that is part of the described Catalogue.
    This property could be used to link the mobility data portal to another data portal, by e.g. harvesting metadata from this other portal into the mobility data portal."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Catalogues."@en ;
    dcam:domainIncludes dcat:Catalog ;
    dcam:rangeIncludes dcat:Catalog ;
    rdfs:seeAlso <http://purl.org/dc/terms/hasPart> .

### http://purl.org/dc/terms/hasVersion
dct:hasVersion 
    rdfs:comment """This property refers to a related dataset that is a version, edition, or adaptation of the described dataset. Corresponds to the property "dct:isVersionOf", with a contrary relationship. It might be used to host multiple versions of the same data set in the data portal, also enabling a version history. Multiple versions should be differentiated via the properties "owl:versionInfo" and "adms:versionNotes"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dcat:Dataset ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#hasVersion> .

### http://purl.org/dc/terms/isReferencedBy
dct:isReferencedBy 
    rdfs:comment """This property MAY reference, cite, or otherwise point to another, related dataset. Corresponds to the property dct:relation, with a contrary relationship. It may be a link between two individual datasets that complement each other, e.g. one dataset with static parking data, and one with dynamic parking data, both covering the same parking facilities."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#isReferencedBy> .

### http://purl.org/dc/terms/isVersionOf
dct:isVersionOf 
    rdfs:comment """This property refers to a related dataset of which the described dataset is a version, edition, or adaptation. Corresponds to property dct:hasVersion with contrary relationship. It might be used to host multiple versions of the same data set in the data portal, also enabling a version history. Multiple versions should be differentiated via the properties owl:versionInfo and adms:versionNotes."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes dcat:Dataset ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#isVersionOf> .

### http://purl.org/dc/terms/language
dct:language 
    rdfs:comment """For Catalogue, this property refers to a language used in the user interface of the mobility data portal, in particular the textual metadata describing the datasets registered in the portal. This property can be repeated if the user interface and textual metadata are provided in multiple languages - see 12. Accessibility and Multilingual Aspects.

    For Catalogue Record, it refers to the language used in the textual metadata describing titles, descriptions, etc. of the metadata entry.
    The value may be generated automatically by the NAP system, corresponding to the currently used language in the user interface. Some portals offer multilingual user interfaces, e.g., in the local language and additionally in English. For multiple languages - see 12. Accessibility and Multilingual Aspects.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0.

    For Dataset, it refers to the language of the content data in a dataset, if this content has a natural language embedded, such as text fields, addresses etc.
    The language of the content data in a dataset, if this content has a natural language embedded, such as text fields, addresses etc.

    For Distribution, it describes the language of the content data in a distribution, if this content has a natural language embedded, such as text fields, addresses etc.
    There is the same property dct:language under class Dataset. Language information on the distribution level is only recommended, if there are multiple distributions for the same dataset with a different language each.
    This property can be repeated if there are multiple languages in the distribution - see 12. Accessibility and Multilingual Aspects"""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Catalogues, it is a mandatory property to be used for Catalogue Records, and it is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:CatalogRecord ,
                        dcat:Dataset ,
                        dcat:Distribution ;
    dcam:rangeIncludes dct:LinguisticSystem ;
    rdfs:seeAlso <http://purl.org/dc/terms/language> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#accessibility-and-multilingual-aspects> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-language> .

### https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#license
dct:license 
    rdfs:comment """ For Catalogue, this property refers to the licence under which the Catalogue can be used or reused.

    For Distribution, it refers to the licence under which the distribution is made available. This should be a reference to a concrete (standard) licence.
    A controlled vocabulary is provided."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Catalogues and Distributions, and it is an optional property to be used for Data Services."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:DataService ,
                        dcat:Distribution ;
    dcam:rangeIncludes dct:LicenseDocument ;
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#license> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#vocab-standard-licence> .

### http://purl.org/dc/terms/modified
dct:modified 
    rdfs:comment """For Catalogue, this property contains the most recent date on which the Catalogue was modified. It is recommended to indicate modifications of the portal system as such (e.g., major technical updates of the portal or its features), rather than modifications of the hosted datasets, since datasets on mobility data portals are updaded frequently.

    For Catalogue Record, this property contains the most recent date on which the metadata entry was changed or modified.
    It should be generated by the system, whenever a platform user updates the metadata entry. If there has been no update yet, the value from the property dct:created should be taken.

    For Dataset, this property contains the most recent date on which the content of the dataset was changed or modified.
    This is redundant for high-frequency data feeds (e.g., DATEX II feeds), where the change date can be derived from the time stamp within the data feed.

    For Dataset Series, it refers to the most recent date on which the dataset series was changed or modified.
    This should correspond to the most recent modification date of all datasets in the collection, as declared via property dct:modified.

    For Distribution, it contains the most recent date on which the Distribution was changed or modified. 
    There is the same property dct:modified under the Dataset level. Under the distribution level, this property describes temporal changes in the characteristics of a distribution, e.g., a new data format or similar."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Catalogues, it is a mandatory property to be used for Catalogue Records, and is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:CatalogRecord ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ,
                        dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal ;  
    rdfs:seeAlso <http://purl.org/dc/terms/modified> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/catalogue-record-creation-date> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-modification-date> .

### http://purl.org/dc/terms/relation
dct:relation 
    rdfs:comment """For Datasets, this property MAY reference, cite, or otherwise point to another, related dataset. Corresponds to the property dct:isReferencedBy, with contrary relationship. It may be a link between two individual datasets that complement each other, e.g. one dataset with static parking data, and one with dynamic parking data, both covering the same parking facilities.
    For Relationships, this property refers to the resource related to the source resource."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets; and a mandatory property to be used for Relationships. "@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes rdfs:Resource ;  
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#relation> .

### http://purl.org/dc/terms/rights
dct:rights 
    rdfs:comment """This property links to a Rights Statement, i.e., a statement about the intellectual property rights (IPR). As a minimum, it should include an information on the type of conditions for access and usage. A concrete (standard) license can be referred via the recommended property dct:license. The obligation of this property is raised to "mandatory", compared to [DCAT-AP-v2.0.1]."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Distributions."@en ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes dct:RightsStatement ;  
    rdfs:seeAlso <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#rights> .


### http://purl.org/dc/terms/spatial
dct:spatial 
    rdfs:comment """For Catalogue, this property refers to a geographical area covered by the Catalogue.
    For National Access Points (NAPs), this corresponds to the EU Member State or a country that installs such NAP. The property might be used for analyses about available datasets per country, or to identify country-specific metadata in case metadata are federated from multiple national portals into an international portal. It is not to be mixed up with country codes used within the dataset property dct:spatial, which might be different.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0.

    For Dataset, this property refers to a geographic region that is covered by the delivered content.
    The obligation of this property is raised to “mandatory”, compared to DCAT-AP v3.0.0.

    For DatasetSeries, this property refers to a geographic region that is covered by the dataset series.
    When spatial coverage is a dimension in the dataset series then the spatial coverage of each dataset in the collection should be part of the spatial coverage of the dataset series. In that case, the value of the spatial coverage of the dataset series should be as wide as possiblie. E.g., if datasets in a collection are about different regions in a country, the spatial coverage of the dataset series should note the entire country. See also the examples no. 7 and 8 in the Dataset Series examples section of DCAT-AP v3.0.0."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues, and Datasets."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        dcat:Dataset ,
                        dcat:DatasetSeries ;
    dcam:rangeIncludes dct:Location ;  
    rdfs:seeAlso <http://purl.org/dc/terms/spatial> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-geographical-coverage> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.1/#example-dataset-series> .

### http://purl.org/dc/terms/title
dct:title
    rdfs:comment """For Catalogue, this property contains a name given to the mobility data portal.
    This property can be repeated for parallel language versions of the name - see 12. Accessibility and Multilingual Aspects.

    For Concept Scheme, this property contains a name of the concept scheme.
    This property can be repeated for parallel language versions of the name - see 12. Accessibility and Multilingual Aspects.

    For Dataset, this property contains a the name given to the dataset in a generic term. The name should be a meaningful, unique and unambiguous label.
    This property can be repeated for parallel language versions of the title - see 12. Accessibility and Multilingual Aspects. The language version should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the title.

    For Dataset Series, this property contains the name given to the dataset series in a generic term. The name should be a meaningful, unique and unambiguous label.
    This property can be repeated for parallel language versions of the title - see 12. Accessibility and Multilingual Aspects.

    For Distribution, this property contains a name given to the Distribution. This property can be repeated for parallel language versions of the title - see 12. Accessibility and Multilingual Aspects.

    For Mobility Data Standard, this property contains a name given to the mobility data standard.
    This property can be repeated for parallel language versions of the title - see 12. Accessibility and Multilingual Aspects."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues, Category Schemes,Data Services, and Datasets; and it is an optional property to be used for Distributions."@en ;
    dcam:domainIncludes dcat:Catalog ,
                        skos:ConceptScheme ,
                        dcat:DatasetSeries ,
                        dcat:Dataset ,
                        dcat:Distribution ,
                        mobilitydcatap:MobilityDataStandard ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://purl.org/dc/terms/title> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#accessibility-and-multilingual-aspects> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/catalogue-record-language> .


### https://spdx.org/rdf/3.0.1/terms/Core/algorithm
spdx:algorithm 
    rdfs:comment """This property identifies the algorithm used to produce the subject Checksum. Currently, SHA-1 is the only supported algorithm. It is anticipated that other algorithms will be supported at a later time."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an mandatory property for Checksum."@en ;
    dcam:domainIncludes spdx:Checksum ;
    dcam:rangeIncludes spdx:checksumAlgorithm_sha1 ;
    rdfs:seeAlso <https://spdx.org/rdf/3.0.1/terms/Core/algorithm> .

### http://spdx.org/rdf/terms#checksumValue
spdx:checksumValue 
    rdfs:comment """This property provides a lower case hexadecimal encoded digest value produced using a specific algorithm. The range of this property is rdfs:Literal typed as xsd:hexBinary."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property for Checksum."@en ;
    dcam:domainIncludes spdx:Checksum ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://spdx.org/rdf/terms#checksumValue> .

### https://www.w3.org/TR/owl-ref/#versionInfo-def
owl:versionInfo a rdf:Property ;
    rdfs:comment """For Dataset, this property contains a version number or other version designation of the dataset. The version should be updated, whenever there are changes to the dataset noted by the property dct:modified. Together with property adms:versionNotes, this MAY also enable a change history (or version history) of the corresponding dataset, which could be hosted and published on the data platform. It is recommended to follow W3C Data on the Web Best Practices [DWBP]. Version identifiers should enable comparison of versions and distinguishing major from minor versions, such as Semantic Versioning [SEMVER].
    For Mobility Data Standard, this property describes the version of the mobility data standard, as applied within the delivered content. A version might be, e.g., DATEX II v3.2. This information is provided in a textual format. To avoid ambiguity, only short version identifiers SHOULD be used, e.g., only "3.2", without redundant acronyms such as "v", underscores etc."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property for Datasets and for Mobility Data Standards."@en ;
    dcam:domainIncludes mobilitydcatap:MobilityDataStandard ,
                        dcat:Dataset ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/owl-ref/#versionInfo-def> ,
                <https://www.w3.org/TR/dwbp/> ,
                <https://semver.org/> .

### https://www.w3.org/TR/skos-reference/#notation
skos:notation 
    rdfs:comment """This property contains a string that is an identifier in the context of the identifier scheme referenced by its data type. Its range is rdfs:Literal typed with the URI of one of the members of the DataCite Resource Identifier Scheme [DataCite-RIS]."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Identifiers."@en ;
    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/skos-reference/#notations> .

### https://www.w3.org/TR/vcard-rdf/#d4e1819
vcard:Kind 
    rdfs:comment """A description following the VCARD-RDF specification, e.g. to provide telephone number and e-mail address for a contact point.
    This class is the parent class for the four explicit types of vCards (vcard:Individual, vcard:Organization, vcard:Location, vcard:Group).
    The contact point might be populated with the same information as for an agent, see class foaf:Agent. See 11. Agent Types, Agent Roles and Contact Information for further usage notes on that matter.
    When providing contact information, data publishers SHOULD prioritize organizational information over personal details. The exposure of personal information, such as a personal name and email address, may be restricted to the public. Instead, there might be an anonymous contact channel, e.g. a contact button on the GUI that triggers an email to the agent. See 13. Privacy and security considerations.
    For this entity the following properties are defined: "address (vcard:hasAddress)", "affiliation(vcard:organization-name)", "email(vcard:hasEmail)", "name (vcard:fn)", "phone (vcard:hasTelephone)", "URL (vcard:hasURL)"."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional class."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vcard-rdf/#d4e1819> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/#Kind> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/#Kind> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1749> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e2121> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1865> ,
                <https://www.w3.org/TR/vcard-rdf/#d4e1667> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#class-agent> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#agent-roles> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#privsec> .
                 

### https://www.w3.org/ns/adms#version
adms:versionNotes 
    rdfs:comment """This property contains a textual description of the differences between this version and a previous version of the dataset, as an addition to the property owl:versionInfo. This property can be repeated for parallel language versions of the version notes - see § 8. Accessibility and Multilingual Aspects."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:DataService ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-adms/#adms-versionnotes> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#accessibility-and-multilingual-aspects> .

### https://www.w3.org/ns/dcat#accessService
dcat:accessService 
    rdfs:comment """This property refers to a Data Service that gives access to the Distribution of the Dataset."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distribution. "@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_service> .
    

### https://www.w3.org/ns/dcat#accessURL  
dcat:accessURL 
    rdfs:comment """This property contains a URL that gives access to a Distribution of the Dataset. Depending on the type of data provision, there are different options for describing the URL. For data services, e.g., API, broker services, data feeds, etc., the URL MAY be the end point of such service. However, if some agreements between the data provider and the data user need to be established first, the access URL may link to web page, where the access is further arranged, e.g., initiating a a subscription process. For data which can be downloaded directly, the download URL should be copied from the optional property dcat:downloadURL. For other cases, where data cannot be directly accessed or downloaded via the platform, the access URL MAY be a link to an external service or a website which enables access to the data. This way, this property is the primary key to link to a data service. There is also specific class dcat:DataService, which can be linked via property dcat:accessService. See § 4.9 Data Service for a usage note about the class Data Service."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Distributions."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_access_url> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/3.0.0/index.html#properties-for-data-service> .

### https://www.w3.org/ns/dcat#bbox
dcat:bbox 
    rdfs:comment """This property refers to the geographic bounding box of a resource."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Locations."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:location_bbox> .
    
### https://www.w3.org/ns/dcat#centroid
dcat:centroid 
    rdfs:comment """This property refers to the geographic centre (centroid) of a resource."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Locations."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:location_centroid> .

### https://www.w3.org/TR/vocab-dcat-3/#Property:catalog_dataset
dcat:dataset 
    rdfs:comment """This property links the mobility data portal with a data set that is described at the mobility data portal. 
    This is a direct link from the mobility data portal to a dataset. However, in mobilityDCAT-AP, datasets should be linked indirectly, i.e., via the metadata record of this dataset. Thus, it is mandatory to use the property dcat:record to link to a data set. The usage of dcat:dataset may be then redundant."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:catalog_dataset> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#catalogue-record> .

### https://www.w3.org/ns/dcat#downloadURL
dcat:downloadURL 
    rdfs:comment """This property contains a URL that is a direct link to a downloadable file in a given format."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Distributions."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:distribution_download_url> .
    

### https://www.w3.org/ns/dcat#endDate
dcat:endDate 
    rdfs:comment """This property contains the end of the Period of Time. Its range is rdfs:Literal typed as xsd:date or xsd:dateTime. """@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Periods of Time."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:period_end_date> .
    

### https://www.w3.org/ns/dcat#endpointDescription
dcat:endpointDescription 
    rdfs:comment """This property contains a description of the Data Services available via the endpoints, including their operations, parameters etc. The property gives specific details of the actual endpoint instances, while dct:conformsTo is used to indicate the general standard or specification that the endpoints implement."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Data Services."@en ;
    dcam:domainIncludes dcat:DataService ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:data_service_endpoint_description> .

### http://www.w3.org/ns/dcat#endpointURL
dcat:endpointURL 
    rdfs:comment """The root location or primary endpoint of the Service (an IRI)."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an mandatory property for Data Service."@en ;
    dcam:domainIncludes dcat:DataService ;
    dcam:rangeIncludes rdfs:Resource ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:data_service_endpoint_url> .

### https://www.w3.org/ns/dcat#hadRole
dcat:hadRole 
    rdfs:comment """This property refers to the function of an entity or agent with respect to another entity or resource."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an mandatory property for Relationship."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:relationship_hadRole> .

### https://www.w3.org/ns/dcat#keyword
dcat:keyword 
    rdfs:comment """This property contains a keyword or tag describing the Dataset. For the purposes of mobility data portals, it is not recommended to use keywords, as they might be ambiguous, language-dependent and make data search difficult. Instead, usage of mobility-related properties with Controlled Vocabularies is recommended, in particular dcat:theme, mobilitydcatap:networkCoverage and mobilitydcatap:transportMode. If there are relevant keywords that are not part of such Controlled Vocabularies, please contact the authors of "mobilityDCAT-AP", in order to update the Controlled Vocabularies."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-2/#Property:resource_keyword> .
    
### https://www.w3.org/ns/dcat#record
dcat:record 
    rdfs:comment """This property refers to a metadata record that is part of the mobility data portal. 
    mobilityDCAT-AP assumes that metadata records are essential in mobility data portals, so the obligation of this property is raised to "mandatory", comparing to DCAT-AP v3.0.0."""@en;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues."@en ;
    rdfs:seeAlso <https://www.w3.org/ns/dcat#record> ;
    rdfs:seeAlso <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> .

### https://www.w3.org/ns/dcat#servesDataset
dcat:servesDataset 
    rdfs:comment """This property refers to a Dataset that this Data Service can distribute."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Data Services."@en ;
    dcam:domainIncludes dcat:DataService ;
    dcam:rangeIncludes dcat:Dataset ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:data_service_serves_dataset> .

### https://www.w3.org/ns/dcat#startDate
dcat:startDate 
    rdfs:comment """This property contains the start of the Period of Time."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Periods of Time."@en ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-3/#Property:period_start_date> .


### https://www.w3.org/ns/dcat#theme
dcat:theme 
    rdfs:comment """This property refers to the generic theme (i.e., a specific subject, category, or type) of the delivered content. A dataset may be associated with multiple themes. The category is described via a controlled vocabulary "Data Themes" by the Publications Office of the European Union [EUV-THEMES]. In most cases, it is assumed that the relevant value from this EU vocabulary is "Transport" [EUV-THEMES-TRANSPORT]. A controlled vocabulary is provided."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Datasets."@en ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes skos:Concept ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-2/#Property:resource_theme> ;
    rdfs:seeAlso <https://publications.europa.eu/en/web/eu-vocabularies/at-dataset/-/resource/dataset/data-theme> ;
    rdfs:seeAlso <https://op.europa.eu/en/web/eu-vocabularies/concept/-/resource?uri=http://publications.europa.eu/resource/authority/data-theme/TRAN> ;
    rdfs:seeAlso <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-theme> .
    

### http://www.w3.org/ns/dcat#themeTaxonomy
dcat:themeTaxonomy 
    rdfs:comment """This property refers to a knowledge organization system used to classify the mobility data portal's datasets.
    Recommended to indicate the version of the controlled vocabulary for property mobilitydcatap:mobilityTheme, that is used in the mobility data portal."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property to be used for Catalogues."@en ;
    dcam:domainIncludes dcat:Catalog ;
    dcam:rangeIncludes skos:ConceptScheme ;
    rdfs:seeAlso <http://www.w3.org/ns/dcat#themeTaxonomy> ,
                <https://mobilitydcat-ap.github.io/mobilityDCAT-AP/drafts/latest/#dataset-mobility-theme> .

### https://www.w3.org/ns/legacy_locn#locn:geometry
locn:geometry 
    rdfs:comment """This property associates any resource with the corresponding geometry."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is an optional property to be used for Locations."@en ;
    rdfs:seeAlso <https://www.w3.org/ns/legacy_locn#locn:geometry> .


### https://xmlns.com/foaf/spec/#term_homepage
foaf:homepage 
    rdfs:comment """This property refers to a web page that acts as the main page for the Catalogue. This property could be used to link the mobility data portal to another data portal, by e.g. harvesting metadata from this other portal into the mobility data portal.
    The obligation of this property is raised to “mandatory”, comparing to DCAT-AP v3.0.0."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues."@en ;
    rdfs:seeAlso <https://xmlns.com/foaf/spec/#term_homepage> ,
                <https://semiceu.github.io/DCAT-AP/releases/3.0.0/> .

### https://xmlns.com/foaf/spec/#term_primaryTopic
foaf:primaryTopic 
    rdfs:comment """This property links the metadata entry to the dataset described in the entry."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property for Catalogue Records." ;
    dcam:domainIncludes dcat:CatalogRecord ;
    dcam:rangeIncludes dcat:Dataset ;
    rdfs:seeAlso <https://xmlns.com/foaf/spec/#term_primaryTopic> .


### https://www.w3.org/ns/dcat#contactPoint
dcat:contactPoint 
    rdfs:comment """This property contains contact information that can be used for communication with a company or person responsible for the dataset. Such contact is important for any questions or issues about a dataset and its provisioning, which might raised by a platform user or a platform operator. The provided contact information, such as a personal name and email address, MAY NOT be exposed to platform users, but MAY be anonymously used via, e.g. a contact button on the GUI that triggers an email to the contact point."""@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a recommended property for Datasets." ;
    dcam:domainIncludes dcat:Dataset ;
    dcam:rangeIncludes vcard:Kind ;
    rdfs:seeAlso <https://www.w3.org/TR/vocab-dcat-2/#Property:resource_contact_point> .



