    dcam:domainIncludes dcat:Distribution ;
    dcam:rangeIncludes rdfs:Literal ;
    rdfs:seeAlso <http://www.w3.org/2011/content#characterEncoding> ,
                <https://www.iana.org/assignments/character-sets/character-sets.xhtml> ,
                <https://semiceu.github.io/GeoDCAT-AP/releases/3.0.0/> .	 
		  
###  https://www.w3.org/TR/vcard-rdf/#d4e891
vcard:fn rdf:type owl:DatatypeProperty ;
    rdfs:comment """A name of the kind, i.e., a unique name of an individual, an organization, a location or a group.
    This property corresponds to the addition by geoDCAT-AP v3.0.0, however, with an raised obligation level."""@en ;
    rdfs:label "name"@en ;
    skos:scopeNote "In mobilityDCAT-AP, this is a mandatory property to be used for Kind."@en ;
