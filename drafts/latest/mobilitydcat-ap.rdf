    <!-- http://purl.org/dc/terms/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description">
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dcam:rangeIncludes rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">For Catalogue, this property contains a free-text, individual name of the mobility data platform itself. This property MAY be repeated for parallel language versions of the description - see § 8. Accessibility and Multilingual Aspects.
    For Data Service, this property contains a free-text account of the Data Service. This property can be repeated for parallel language versions of the description - see § 8. Accessibility and Multilingual Aspects.
    For Dataset, this property contains more information about the dataset as a brief, free-text description. It is used only for a brief overview, because free-text fields are unsuitable for searches, due to spelling mistakes, different wordings and other aspects. The categorisation and other aspects about the dataset are described within other properties of the dataset. This property can be repeated for parallel language versions of the description - see § 8. Accessibility and Multilingual Aspects. The language versions should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the description.
    For Distribution, this property contains a free-text account of the Distribution. This property can be repeated for parallel language versions of the description - see § 8. Accessibility and Multilingual Aspects.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/description"/>
        <rdfs:seeAlso rdf:resource="https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#accessibility-and-multilingual-aspects"/>
        <skos:scopeNote xml:lang="en">In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues and Datasets, it is a recommended property to be used for Distributions, and it is an optional property to be used for Data Services </skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/issued"/>
    


    <!-- http://purl.org/dc/terms/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license">
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <dcam:rangeIncludes rdf:resource="http://purl.org/dc/terms/LicenseDocument"/>
        <rdfs:comment xml:lang="en"> For Catalogue, this property refers to the licence under which the Catalogue can be used or reused.
    For Data Service, this property contains the licence under which the Data Service is made available.
    For Distribution, this property refers to the licence under which the Distribution is made available. This SHOULD be a reference to a concrete standard license. A controlled vocabulary is provided.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/license"/>
        <rdfs:seeAlso rdf:resource="https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-licence"/>
        <skos:scopeNote xml:lang="en">In mobilityDCAT-AP, this is a recommended property to be used for Catalogues and Distributions, and it is an optional property to be used for Data Services.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified">
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#CatalogRecord"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dcam:rangeIncludes rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">For Catalogue, this property contains the most recent date on which the Catalogue was modified.
    For Catalogue Record, this property contains the date stamp (date and time) when the metadata entry was last modified. It SHOULD be generated by the system, whenever a platform user updates the metadata entry. If there has been no update yet, the value from the property &apos;&apos;creation date&apos;&apos; SHOULD be taken.
    For Dataset, this property MAY contain the most recent date on which the content of a dataset was changed or modified. This is redundant for high-frequency data services, e.g., via a data feed service, where the change date can be derived from the time stamp within the data feed.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#modified"/>
        <skos:scopeNote xml:lang="en">In mobilityDCAT-AP, this is a recommended property to be used for Catalogues, it is a mandatory property to be used for Catalogue Records, and is an optional property to be used for Datasets.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/publisher -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/dc/terms/rightsHolder -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/rightsHolder"/>
    


    <!-- http://purl.org/dc/terms/title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title">
        <dcam:domainIncludes rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#DataService"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <dcam:domainIncludes rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <dcam:rangeIncludes rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
        <rdfs:comment xml:lang="en">For Catalogue, this property contains a name given to the mobility data portal, a name of the Category Scheme, a name given to the Data Service, a name given to the Dataset in a generic term. The name should be a meaningful, unique and unambiguous label. This property can be repeated for parallel language versions of the name - see § 8. Accessibility and Multilingual Aspects. The language versions should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the title.
    For Category Scheme, this property contains a name of the Category Scheme. May be repeated for different versions of the name - see § 8. Accessibility and Multilingual Aspects.
    For Data Service, this property contains a name given to the Data Service. This property can be repeated for parallel language versions of the name - see § 8. Accessibility and Multilingual Aspects.
    For Dataset, this property contains a name given to the dataset in a generic term. The name should be a meaningful, unique and unambiguous label. This property can be repeated for parallel language versions of the name - see § 8. Accessibility and Multilingual Aspects.The language versions should correspond to property dct:language of class Catalogue Record. I.e., if more than one language is provided as a metadata language, there should be as many language versions for the title.
    For Distribution, this property contains a name given to the Distribution. This property can be repeated for parallel language versions of the description - see § 8. Accessibility and Multilingual Aspects.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="http://purl.org/dc/terms/title"/>
        <rdfs:seeAlso rdf:resource="https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#accessibility-and-multilingual-aspects"/>
        <skos:scopeNote xml:lang="en">In mobilityDCAT-AP, this is a mandatory property to be used for Catalogues, Category Schemes,Data Services, and Datasets; and it is an optional property to be used for Distributions.</skos:scopeNote>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/type -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/type">
        <dcam:domainIncludes rdf:resource="http://purl.org/dc/terms/RightsStatement"/>
        <dcam:domainIncludes rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <dcam:rangeIncludes rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">In mobilityDCAT-AP, this property it is used as in DCAT-AP. Depending on the context, this property is used to describe the type of Agent that makes the Catalogue, Catalogue Record, Data Service, or Dataset available; for this purpose, a controlled vocabulary is provided. Moreover, this property MUST be used to indicate the conditions, if any, under which contracts, licences, and/or are applied for the use of the dataset. The conditions are declared on an aggregated level: whether a free and unrestricted use is possible, a contract has to be concluded and/or a licence has to be agreed on to use a dataset; A controlled vocabulary is provided. The values can be logically mapped with the property dct:identifier from class dct:LicenseDocument.</rdfs:comment>
        <rdfs:seeAlso rdf:resource="https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-conditionsforusage"/>
        <rdfs:seeAlso rdf:resource="https://mobilitydcat-ap.github.io/mobilityDCAT-AP/releases/index.html#vocab-publisher-type"/>
        <rdfs:seeAlso rdf:resource="https://www.dublincore.org/specifications/dublin-core/dcmi-terms/#type"/>
        <vs:term_status>stable</vs:term_status>
        <skos:scopeNote xml:lang="en">In mobilityDCAT-AP, this is a recommended property to be used for Agents, and it is a mandatory property to be used for Rights Statements.</skos:scopeNote>
        <adms:status rdf:resource="http://publications.europa.eu/resource/dataset/concept-status/CURRENT"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/ontology/bibo/editor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/editor"/>
    


    <!-- http://purl.org/vocab/vann/preferredNamespacePrefix -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann/preferredNamespacePrefix"/>
    


