<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:dct="http://purl.org/dc/terms/"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:Ontology rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0">
    <dct:description xml:lang="en">owl:imports of the controlled vocabularies applied by mobilityDCAT-AP 3.0.0 (spec section 10.2): those created and maintained by mobilityDCAT-AP, and those maintained by external organisations.</dct:description>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-23</dct:modified>
    <dct:title xml:lang="en">mobilityDCAT-AP 3.0.0 Applied Controlled-Vocabulary Imports</dct:title>
    <rdfs:label xml:lang="en">mobilityDCAT-AP applied controlled-vocabulary imports</rdfs:label>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/continent"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/corporate-body"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/country"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/data-theme"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/distribution-status"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/file-type"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/frequency"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/language"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/licence"/>
    <owl:imports rdf:resource="http://publications.europa.eu/resource/authority/place"/>
    <owl:imports rdf:resource="https://github.com/SEMICeu/ADMS-AP/raw/master/purl.org/ADMS_SKOS_v1.00.rdf"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/application-layer-protocol"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/communication-method"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/conditions-for-access-and-usage"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/georeferencing-method"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/intended-information-service"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-data-standard"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/mobility-theme"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/network-coverage"/>
    <owl:imports rdf:resource="https://w3id.org/mobilitydcat-ap/transport-mode"/>
    <owl:versionInfo>3.0.0</owl:versionInfo>
  </owl:Ontology>
</rdf:RDF>
