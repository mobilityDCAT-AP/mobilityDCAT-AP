        <sh:description xml:lang="en">The technical syntax of the delivered content, taken from the EU File type authority table (http://publications.europa.eu/resource/authority/file-type). The value space is closed: only concepts from this vocabulary are allowed.</sh:description>
        <sh:message xml:lang="en">format value must be a concept from the EU File Type table (skos:inScheme).</sh:message>
        <sh:node rdf:resource="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#FileTypeRestriction"/>
