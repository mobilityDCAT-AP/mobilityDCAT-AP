  <sh:NodeShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges#Catalogue_Shape">
    <sh:name xml:lang="en">Catalogue (mobilityDCAT-AP) - Range Constraints</sh:name>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges#Catalogue_Shape_homepage_range">
        <sh:description xml:lang="en">Homepage range is foaf:Document in mobilityDCAT-AP (v3 changelog), enforced here as sh:nodeKind sh:IRI since homepages are referenced as bare IRIs, not inline-typed in instance data.</sh:description>
        <sh:message xml:lang="en">Homepage must be an IRI</sh:message>
        <sh:name xml:lang="en">homepage (range)</sh:name>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#IRI"/>
        <sh:path rdf:resource="http://xmlns.com/foaf/0.1/homepage"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:property>
      <sh:PropertyShape rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges#Catalogue_Shape_spatial_range">
        <sh:message xml:lang="en">Catalogue geographical coverage must be a blank node or an IRI (e.g. country code from EU authority table or Geonames).</sh:message>
        <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#BlankNodeOrIRI"/>
        <sh:path rdf:resource="http://purl.org/dc/terms/spatial"/>
        <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Violation"/>
      </sh:PropertyShape>
    </sh:property>
    <sh:targetClass rdf:resource="http://www.w3.org/ns/dcat#Catalog"/>
  </sh:NodeShape>
  <owl:Ontology rdf:about="https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/ranges">
    <dct:creator>
      <foaf:Group rdf:nodeID="cbb7ba835447896e8fda285d5dc4b0aa0afb6fdebafbda714b9af0936be96f0333">
        <foaf:name>NAPCORE SWG 4.4</foaf:name>
        <foaf:page rdf:resource="https://github.com/mobilityDCAT-AP/mobilityDCAT-AP"/>
      </foaf:Group>
    </dct:creator>
    <dct:description xml:lang="en">Adds mobilityDCAT-AP-specific node-kind / class range constraints, extending DCAT-AP 3.0.1. CV-code and external-IRI references use sh:nodeKind sh:IRI; CV membership is checked in the MDR file. DCAT-AP ranges are inherited via owl:imports and not restated.</dct:description>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-23</dct:modified>
    <dct:publisher rdf:resource="https://napcore.eu/"/>
    <dct:rightsHolder rdf:resource="https://napcore.eu/"/>
    <dct:title xml:lang="en">mobilityDCAT-AP 3.0.0 SHACL - Range Constraints</dct:title>
    <bibo:editor>
      <foaf:Person rdf:nodeID="cb4f1a592ae128e1d61c62ee165e5776accdfec1c87c8080dc084e5ff663320a2e">
        <owl:sameAs rdf:resource="https://orcid.org/0000-0001-5446-6947"/>
        <foaf:name>Lina Molinas Comet</foaf:name>
      </foaf:Person>
    </bibo:editor>
    <bibo:editor>
      <foaf:Person rdf:nodeID="cb7b2764b50c8108242a7c41bf4ad750a9465d47c311f5dcabf680f139b0ec3433">
        <owl:sameAs rdf:resource="https://orcid.org/0000-0002-8235-7331"/>
        <foaf:name>Mario Scrocca</foaf:name>
      </foaf:Person>
    </bibo:editor>
    <bibo:editor>
      <foaf:Person rdf:nodeID="cb8d9d0e7b2c67a903c3710e7378c699c97592a5187f9229b0cbbe811856e7c47e">
        <owl:sameAs rdf:resource="https://orcid.org/0000-0003-1867-4428"/>
        <foaf:name>Daham Mustafa</foaf:name>
      </foaf:Person>
    </bibo:editor>
