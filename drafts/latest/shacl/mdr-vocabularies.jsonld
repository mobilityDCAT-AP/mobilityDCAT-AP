    "http://www.w3.org/ns/shacl#description": [
      {
        "@language": "en",
        "@value": "The spatial reference system used in the dataset, identified by a coordinate reference system URI from the OGC EPSG register. This register is not a SKOS scheme, so membership is checked by URI pattern rather than skos:inScheme. The value space is closed: only EPSG URIs are allowed."
      }
    ],
    "http://www.w3.org/ns/shacl#message": [
      {
        "@language": "en",
        "@value": "referenceSystem value must be an OGC EPSG coordinate reference system URI."
      }
    ],
    "http://www.w3.org/ns/shacl#node": [
      {
        "@id": "https://w3id.org/mobilitydcat-ap/releases/3.0.0/shacl/mdr-vocabularies#ReferenceSystemRestriction"
      }
    ],
